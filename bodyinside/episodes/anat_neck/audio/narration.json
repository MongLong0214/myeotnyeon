[
 {
  "line": 0,
  "beat": 0,
  "text": "목뼈는 원래 앞으로 살짝 휜 씨짜예요.",
  "start": 0.15,
  "end": 2.5025,
  "syll": 15,
  "rate": 6.38,
  "atempo": 1.346,
  "file": "narr_0.wav"
 },
 {
  "line": 1,
  "beat": 1,
  "text": "고개를 숙일수록 하-중이 커져요. 컴퓨터 모델로는 60도에서 약 27킬로까지 추정돼요.",
  "start": 2.95,
  "end": 7.949,
  "syll": 32,
  "rate": 6.4,
  "atempo": 1.272,
  "file": "narr_1.wav"
 },
 {
  "line": 2,
  "beat": 2,
  "text": "이 자세가 계속되면 씨짜가 펴지다가, 거꾸로 휠 쑤도 있어요. 정도는 사람마다 달라요.",
  "start": 10.15,
  "end": 15.477083333333333,
  "syll": 34,
  "rate": 6.38,
  "atempo": 1.142,
  "file": "narr_2.wav"
 },
 {
  "line": 3,
  "beat": 3,
  "text": "눌-린 디스크가 신경, 쪽으로 밀려날 수도 있어요. 그러면 뿌리를 누를 수 있고요.",
  "start": 16.649979166666668,
  "end": 21.494895833333334,
  "syll": 31,
  "rate": 6.4,
  "atempo": 1.278,
  "file": "narr_3.wav"
 },
 {
  "line": 4,
  "beat": 4,
  "text": "뒷목 근육은 계속 버텨야 해요. 고개가 앞으로 나가 있는 동안에는요.",
  "start": 23.15,
  "end": 27.367791666666665,
  "syll": 27,
  "rate": 6.4,
  "atempo": 1.056,
  "file": "narr_4.wav"
 },
 {
  "line": 5,
  "beat": 5,
  "text": "이런 자세가 굳어지면, 이렇게 보일 수 있어요.",
  "start": 29.65,
  "end": 32.35041666666667,
  "syll": 18,
  "rate": 6.67,
  "atempo": 1.22,
  "file": "narr_5.wav"
 },
 {
  "line": 6,
  "beat": 6,
  "text": "지금 내 귀는 어깨 위에 있나요?",
  "start": 32.65,
  "end": 34.53333333333333,
  "syll": 12,
  "rate": 6.37,
  "atempo": 1.275,
  "file": "narr_6.wav"
 }
]