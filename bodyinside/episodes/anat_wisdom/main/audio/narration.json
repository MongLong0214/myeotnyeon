[
  {
    "line": 0,
    "beat": 0,
    "text": "아래 사랑니는 둘째 큰어금니 뒤에 있는 셋째 큰어금니예요.",
    "start": 0.025,
    "end": 3.8795,
    "syll": 24,
    "rate": 6.23,
    "atempo": 1.167,
    "file": "narr_1.wav"
  },
  {
    "line": 1,
    "beat": 1,
    "text": "앞 어금니 쪽으로 기울거나 옆으로 완전히 누운 경우도 보여요.",
    "start": 4.04,
    "end": 7.892791666666667,
    "syll": 25,
    "rate": 6.49,
    "atempo": 1.034,
    "file": "narr_2.wav"
  },
  {
    "line": 2,
    "beat": 2,
    "text": "똑바로 선 경우나 뒤쪽으로 기울어진 매복 사랑니도 있어요.",
    "start": 8.04,
    "end": 11.893708333333333,
    "syll": 24,
    "rate": 6.23,
    "atempo": 1.164,
    "file": "narr_3.wav"
  },
  {
    "line": 3,
    "beat": 3,
    "text": "입체 영상에선 신경이 지나는 관이 뿌리 가까이 보이기도 해요.",
    "start": 12.04,
    "end": 15.897333333333334,
    "syll": 25,
    "rate": 6.48,
    "atempo": 1.312,
    "file": "narr_4.wav"
  },
  {
    "line": 4,
    "beat": 4,
    "text": "곧게 선 사랑니가 잇몸 밖으로 일부만 나온 사례를 살펴보면요.",
    "start": 16.04,
    "end": 19.892666666666667,
    "syll": 25,
    "rate": 6.49,
    "atempo": 1.143,
    "file": "narr_5.wav"
  },
  {
    "line": 5,
    "beat": 5,
    "text": "그 사랑니를 둘러싼 잇몸에 염증이 관찰된 사례도 있었어요.",
    "start": 20.04,
    "end": 23.891916666666667,
    "syll": 24,
    "rate": 6.23,
    "atempo": 1.249,
    "file": "narr_6.wav"
  },
  {
    "line": 6,
    "beat": 6,
    "text": "기울거나 누운 사랑니 앞 어금니의 뒷면엔 충치도 보였어요.",
    "start": 24.04,
    "end": 27.897833333333335,
    "syll": 24,
    "rate": 6.22,
    "atempo": 1.234,
    "file": "narr_7.wav"
  },
  {
    "line": 7,
    "beat": 7,
    "text": "사랑니의 기울기와 뿌리 아래 신경관 중 어디가 먼저 보이나요?",
    "start": 28.04,
    "end": 31.894166666666667,
    "syll": 25,
    "rate": 6.49,
    "atempo": 1.226,
    "file": "narr_8.wav"
  }
]
