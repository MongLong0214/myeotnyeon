[
 {
  "line": 0,
  "beat": 0,
  "text": "목뼈는 원래 앞으로 살짝 휜 씨짜예요.",
  "start": 0.105,
  "end": 2.4575,
  "rate": 6.38,
  "file": "narr_0.wav"
 },
 {
  "line": 1,
  "beat": 1,
  "text": "고개를 숙일수록 목이 받는 하중이 커져요. 계산해 보면 60도에서 약 27킬로예요.",
  "start": 2.705,
  "end": 8.053125,
  "rate": 6.54,
  "file": "narr_1.wav"
 },
 {
  "line": 2,
  "beat": 2,
  "text": "폰으로 문자를 칠 때 엑스레이를 찍어 보면, 위쪽 목뼈 마디들의 각도가 달라져요.",
  "start": 8.305,
  "end": 13.195583333333333,
  "rate": 6.54,
  "file": "narr_2.wav"
 },
 {
  "line": 3,
  "beat": 3,
  "text": "이 자세에선 머리가 몸통보다 앞으로 나와요.",
  "start": 13.438333333333334,
  "end": 16.19729166666667,
  "rate": 6.52,
  "file": "narr_3.wav"
 },
 {
  "line": 4,
  "beat": 4,
  "text": "목을 45도 숙이면, 목뼈 사이를 누르는 힘이 두 배 가까이 커져요.",
  "start": 16.883333333333333,
  "end": 21.011499999999998,
  "rate": 6.54,
  "file": "narr_4.wav"
 },
 {
  "line": 5,
  "beat": 5,
  "text": "목이 아픈 젊은 환자 2천4백 명을 조사했더니, 스마트폰을 과하게 쓰는 사람들의 디스크 퇴행이 더 심했어요.",
  "start": 21.27166666666667,
  "end": 27.985666666666667,
  "rate": 6.55,
  "file": "narr_5.wav"
 },
 {
  "line": 6,
  "beat": 6,
  "text": "디스크가 튀어나오면 바로 옆 신경뿌리를 눌러, 팔까지 저릴 수 있어요.",
  "start": 28.238333333333333,
  "end": 32.508250000000004,
  "rate": 6.56,
  "file": "narr_6.wav"
 },
 {
  "line": 7,
  "beat": 7,
  "text": "지금 내 귀는 어깨 위에 있나요?",
  "start": 32.77166666666666,
  "end": 34.654999999999994,
  "rate": 6.37,
  "file": "narr_7.wav"
 }
]
