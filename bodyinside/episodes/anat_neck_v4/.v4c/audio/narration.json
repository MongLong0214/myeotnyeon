[
 {
  "line": 0,
  "beat": 0,
  "text": "목뼈는 원래 앞으로 살짝 휜 씨짜예요.",
  "start": 0.105,
  "end": 2.4575,
  "rate": 6.38,
  "file": "narr_0.wav"
 },
 {
  "line": 1,
  "beat": 1,
  "text": "계산 모델에선 고개를 숙일수록 목뼈에 걸리는 힘이 커졌어요.",
  "start": 2.705,
  "end": 6.529958333333333,
  "rate": 6.54,
  "file": "narr_1.wav"
 },
 {
  "line": 2,
  "beat": 2,
  "text": "폰으로 문자를 칠 때 엑스레이를 찍어 보면, 위쪽 목뼈 마디들의 각도가 달라져요.",
  "start": 6.771666666666667,
  "end": 11.66225,
  "rate": 6.54,
  "file": "narr_2.wav"
 },
 {
  "line": 3,
  "beat": 3,
  "text": "이 자세에선 머리가 몸통보다 앞으로 나와요.",
  "start": 11.905000000000001,
  "end": 14.663958333333333,
  "rate": 6.52,
  "file": "narr_3.wav"
 },
 {
  "line": 4,
  "beat": 4,
  "text": "지금 내 귀는 어깨 위에 있나요?",
  "start": 14.905000000000001,
  "end": 16.788333333333334,
  "rate": 6.37,
  "file": "narr_4.wav"
 },
 {
  "line": 5,
  "beat": 5,
  "text": "목 디스크 탈출은 어떤 모습일까요? 디스크가 튀어나와 가까운 신경뿌리를 누르면 팔이 저릴 수 있어요.",
  "start": 17.138333333333335,
  "end": 23.39379166666667,
  "rate": 6.55,
  "file": "narr_5.wav"
 }
]
