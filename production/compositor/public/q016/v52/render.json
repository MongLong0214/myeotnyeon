 "subtitles": [
  {
   "from_": 0,
   "to": 28,
   "text": "도심 역주행 사고로"
  },
  {
   "from_": 28,
   "to": 55,
   "text": "9명이 숨졌습니다."
  },
  {
   "from_": 59,
   "to": 82,
   "text": "몇 년 받았을까?"
  },
  {
   "from_": 86,
   "to": 132,
   "text": "운전자는 급발진을\n주장했지만"
  },
  {
   "from_": 132,
   "to": 172,
   "text": "법원은 받아들이지\n않았죠."
  },
  {
   "from_": 176,
   "to": 214,
   "text": "급발진에서 나타날 신호는"
  },
  {
   "from_": 214,
   "to": 236,
   "text": "없다고 봤습니다."
  },
  {
   "from_": 240,
   "to": 263,
   "text": "1심과 2심은"
  },
  {
   "from_": 263,
   "to": 327,
   "text": "여러 피해를 어떻게\n처벌할지 달리 봤습니다."
  },
  {
   "from_": 332,
   "to": 388,
   "text": "1심은 인도와 차량 충돌 사고를"
  },
  {
   "from_": 388,
   "to": 430,
   "text": "각각 별개의 행위로 봤죠."
  },
  {
   "from_": 433,
   "to": 489,
   "text": "벌금, 집행유예, 실형 중\n무엇이었을까요?"
  },
  {
   "from_": 493,
   "to": 538,
   "text": "2심은 하나의 운전행위로\n봤습니다."
  },
  {
   "from_": 544,
   "to": 565,
   "text": "한 번의 운전으로"
  },
  {
   "from_": 565,
   "to": 608,
   "text": "여러 죄가 성립한\n경우였죠."
  },
  {
   "from_": 613,
   "to": 671,
   "text": "가장 무거운 죄에\n정해진 형으로 처벌합니다."
  },
  {
   "from_": 679,
   "to": 687,
   "text": "실형."
  },
  {
   "from_": 691,
   "to": 730,
   "text": "금고 7년 6개월에서"
  },
  {
   "from_": 730,
   "to": 773,
   "text": "5년으로 줄어\n확정됐습니다."
  },
  {
   "from_": 778,
   "to": 809,
   "text": "금고는 징역과 달리"
  },
  {
   "from_": 809,
   "to": 835,
   "text": "노역 의무가 없습니다."
  },
  {
   "from_": 835,
   "to": 878,
   "text": "다음 사건도\n맞혀 보세요."
  }
 ],
