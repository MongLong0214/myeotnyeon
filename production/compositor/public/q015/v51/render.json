 "subtitles": [
  {
   "from_": 0,
   "to": 35,
   "text": "규정을 어긴 얼차려로"
  },
  {
   "from_": 35,
   "to": 85,
   "text": "훈련병이 숨진 사건입니다."
  },
  {
   "from_": 89,
   "to": 116,
   "text": "몇 년 받았을까?"
  },
  {
   "from_": 119,
   "to": 176,
   "text": "중대장은 훈련병 6명에게"
  },
  {
   "from_": 176,
   "to": 251,
   "text": "규정을 어긴 군기훈련을\n지시한 혐의였죠."
  },
  {
   "from_": 254,
   "to": 284,
   "text": "재판의 쟁점은"
  },
  {
   "from_": 284,
   "to": 350,
   "text": "하나의 행위인지\n여러 행위인지였습니다."
  },
  {
   "from_": 361,
   "to": 431,
   "text": "벌금, 집행유예, 실형 중\n무엇이었을까요?"
  },
  {
   "from_": 437,
   "to": 491,
   "text": "1심은 하나의 행위로\n봤습니다."
  },
  {
   "from_": 498,
   "to": 533,
   "text": "2심은 피해자마다"
  },
  {
   "from_": 533,
   "to": 592,
   "text": "학대 양상이 달랐다고\n판단했죠."
  },
  {
   "from_": 597,
   "to": 657,
   "text": "그래서 여러 행위로\n다시 봤습니다."
  },
  {
   "from_": 666,
   "to": 673,
   "text": "실형."
  },
  {
   "from_": 675,
   "to": 716,
   "text": "중대장은 1심 징역 5년."
  },
  {
   "from_": 719,
   "to": 772,
   "text": "2심은 5년 6개월로 늘었고"
  },
  {
   "from_": 772,
   "to": 812,
   "text": "그대로 확정됐습니다."
  },
  {
   "from_": 817,
   "to": 859,
   "text": "다음 사건도\n맞혀 보세요."
  }
 ],
