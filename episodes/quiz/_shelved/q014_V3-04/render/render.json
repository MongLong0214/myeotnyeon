 "subtitles": [
  {
   "from_": 4,
   "to": 40,
   "text": "해외 피싱 조직의 전화가"
  },
  {
   "from_": 40,
   "to": 115,
   "text": "국내 010 번호로\n뜨게 만든 20대 두 명."
  },
  {
   "from_": 124,
   "to": 187,
   "text": "일주일마다\n전국 모텔을 옮겨 다니며"
  },
  {
   "from_": 187,
   "to": 288,
   "text": "대포폰 136대와\n유심칩 395개를 썼습니다."
  },
  {
   "from_": 297,
   "to": 329,
   "text": "피해자는 39명이고"
  },
  {
   "from_": 329,
   "to": 388,
   "text": "피해액은\n약 11억 원이었어요."
  },
  {
   "from_": 397,
   "to": 470,
   "text": "벌금, 집행유예, 실형 중\n무엇이었을까요?"
  },
  {
   "from_": 470,
   "to": 512,
   "text": "판사는 단순 현금 수거책보다"
  },
  {
   "from_": 512,
   "to": 576,
   "text": "가담 정도가\n무겁다고 봤습니다."
  },
  {
   "from_": 576,
   "to": 629,
   "text": "피해 회복을 위한\n노력도 없었고요."
  },
  {
   "from_": 629,
   "to": 660,
   "text": "다만 범행을 인정했고"
  },
  {
   "from_": 660,
   "to": 721,
   "text": "벌금형보다 무거운\n전과는 없었죠."
  },
  {
   "from_": 733,
   "to": 785,
   "text": "정답은 실형,\n징역 10년입니다."
  },
  {
   "from_": 785,
   "to": 825,
   "text": "검찰 구형 5년의\n두 배였어요."
  },
  {
   "from_": 840,
   "to": 871,
   "text": "다음 사건도\n맞혀 보세요."
  }
 ],
