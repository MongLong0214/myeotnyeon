{
 "items": [
  {
   "id": "C1_1",
   "cue": "C1",
   "act": "incident",
   "start": 0.0,
   "end": 101.619375,
   "file": "episodes/quiz/q017/v52/hook_master.wav",
   "text": "아파트에서 이웃을 일본도로 살해한 사건입니다. 어떤 형이 나왔을까?",
   "start_sample": 0,
   "end_sample": 162591
  },
  {
   "id": "C2_1",
   "cue": "C2",
   "act": "incident",
   "start": 101.619375,
   "end": 184.880625,
   "file": "episodes/quiz/q017/audio/na/C2_1.wav",
   "text": "피고인은 심신미약을 이유로 형을 줄여 달라고 주장했죠.",
   "start_sample": 162591,
   "end_sample": 295809
  },
  {
   "id": "C3_1",
   "cue": "C3",
   "act": "incident",
   "start": 184.880625,
   "end": 271.798125,
   "file": "episodes/quiz/q017/audio/na/C3_1.wav",
   "text": "반대로 검찰은 1심과 2심 모두 사형을 구형했습니다.",
   "start_sample": 295809,
   "end_sample": 434877
  },
  {
   "id": "C4_1",
   "cue": "C4",
   "act": "weigh",
   "start": 271.798125,
   "end": 332.006875,
   "file": "episodes/quiz/q017/audio/na/C4_1.wav",
   "text": "벌금, 집행유예, 실형 중 무엇이었을까요?",
   "start_sample": 434877,
   "end_sample": 531211
  },
  {
   "id": "C4_2",
   "cue": "C4",
   "act": "weigh",
   "start": 332.006875,
   "end": 376.0,
   "file": "episodes/quiz/q017/audio/na/C4_2.wav",
   "text": "2심은 심신미약을 인정했죠.",
   "start_sample": 531211,
   "end_sample": 601600
  },
  {
   "id": "C4_3",
   "cue": "C4",
   "act": "weigh",
   "start": 376.0,
   "end": 427.7475,
   "file": "episodes/quiz/q017/audio/na/C4_3.wav",
   "text": "그래도 형을 줄일 사유는 아니라고 봤죠.",
   "start_sample": 601600,
   "end_sample": 684396
  },
  {
   "id": "C4_4",
   "cue": "C4",
   "act": "weigh",
   "start": 427.7475,
   "end": 506.910625,
   "file": "episodes/quiz/q017/audio/na/C4_4.wav",
   "text": "범행이 중대하고 재범 위험도 있다고 판단했습니다.",
   "start_sample": 684396,
   "end_sample": 811057
  },
  {
   "id": "C5_1",
   "cue": "C5",
   "act": "reveal",
   "start": 506.910625,
   "end": 580.445,
   "file": "episodes/quiz/q017/audio/na/C5_1.wav",
   "text": "정답은 실형. 1심과 2심 모두 무기징역.",
   "start_sample": 811057,
   "end_sample": 928712
  },
  {
   "id": "C5_2",
   "cue": "C5",
   "act": "reveal",
   "start": 580.445,
   "end": 626.85,
   "file": "episodes/quiz/q017/audio/na/C5_2.wav",
   "text": "대법원에서 그대로 확정됐습니다.",
   "start_sample": 928712,
   "end_sample": 1002960
  },
  {
   "id": "C6_1",
   "cue": "C6",
   "act": "outro",
   "start": 626.85,
   "end": 663.661875,
   "file": "episodes/quiz/q017/audio/na/C6_1.wav",
   "text": "다음 사건도 맞혀 보세요.",
   "start_sample": 1002960,
   "end_sample": 1061859
  }
 ],
