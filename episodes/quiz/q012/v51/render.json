 "subtitles": [
  {
   "from_": 0,
   "to": 76,
   "text": "27명이 숨진\n지난해 경북 산불은"
  },
  {
   "from_": 76,
   "to": 121,
   "text": "두 곳에서 시작됐습니다."
  },
  {
   "from_": 125,
   "to": 152,
   "text": "몇 년 나왔을까?"
  },
  {
   "from_": 155,
   "to": 232,
   "text": "그중 한 곳이\n의성군에 있는 과수원이었죠."
  },
  {
   "from_": 236,
   "to": 330,
   "text": "60대 과수원 임차인이\n농사 부산물을 태운 뒤"
  },
  {
   "from_": 330,
   "to": 386,
   "text": "불씨가 꺼졌는지\n확인하지 않고"
  },
  {
   "from_": 386,
   "to": 426,
   "text": "자리를 떠난 혐의였습니다."
  },
  {
   "from_": 435,
   "to": 512,
   "text": "불은 강풍을 타고\n5개 시·군까지 번졌죠."
  },
  {
   "from_": 515,
   "to": 587,
   "text": "149시간 동안\n27명이 숨지고"
  },
  {
   "from_": 587,
   "to": 632,
   "text": "40명이 다쳤습니다."
  },
  {
   "from_": 635,
   "to": 706,
   "text": "벌금, 집행유예, 실형 중\n무엇이었을까요?"
  },
  {
   "from_": 711,
   "to": 800,
   "text": "2심 재판부는 결과가\n상당히 무겁다고 봤습니다."
  },
  {
   "from_": 804,
   "to": 863,
   "text": "죄명은 실수로\n불을 낸 실화였고요."
  },
  {
   "from_": 863,
   "to": 949,
   "text": "2심에서 검찰 구형은\n징역 3년이었습니다."
  },
  {
   "from_": 954,
   "to": 1003,
   "text": "1심은\n징역 2년 6개월에"
  },
  {
   "from_": 1003,
   "to": 1033,
   "text": "집행유예 3년."
  },
  {
   "from_": 1036,
   "to": 1081,
   "text": "2심 판결도\n그대로였습니다."
  },
  {
   "from_": 1091,
   "to": 1130,
   "text": "다음 사건도\n맞혀 보세요."
  }
 ],
