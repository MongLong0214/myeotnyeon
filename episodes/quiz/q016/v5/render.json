 "subtitles": [
  {
   "from_": 0,
   "to": 33,
   "text": "도심 역주행 사고로"
  },
  {
   "from_": 33,
   "to": 66,
   "text": "9명이 숨졌습니다."
  },
  {
   "from_": 66,
   "to": 95,
   "text": "몇 년 받았을까?"
  },
  {
   "from_": 104,
   "to": 146,
   "text": "운전자는 급발진을\n주장했지만"
  },
  {
   "from_": 146,
   "to": 200,
   "text": "법원은 받아들이지\n않았죠."
  },
  {
   "from_": 200,
   "to": 232,
   "text": "급발진에서 나타날 신호는"
  },
  {
   "from_": 232,
   "to": 263,
   "text": "없다고 봤습니다."
  },
  {
   "from_": 272,
   "to": 292,
   "text": "1심과 2심은"
  },
  {
   "from_": 292,
   "to": 371,
   "text": "여러 피해를 어떻게\n처벌할지 달리 봤습니다."
  },
  {
   "from_": 371,
   "to": 419,
   "text": "1심은 인도와 차량 충돌 사고를"
  },
  {
   "from_": 419,
   "to": 471,
   "text": "각각 별개의 행위로 봤죠."
  },
  {
   "from_": 489,
   "to": 554,
   "text": "벌금, 집행유예, 실형 중\n무엇이었을까요?"
  },
  {
   "from_": 554,
   "to": 610,
   "text": "2심은 하나의 운전행위로\n봤습니다."
  },
  {
   "from_": 610,
   "to": 632,
   "text": "한 번의 운전으로"
  },
  {
   "from_": 632,
   "to": 683,
   "text": "여러 죄가 성립한\n경우였죠."
  },
  {
   "from_": 683,
   "to": 748,
   "text": "가장 무거운 죄에\n정해진 형으로 처벌합니다."
  },
  {
   "from_": 769,
   "to": 789,
   "text": "실형."
  },
  {
   "from_": 789,
   "to": 819,
   "text": "금고 7년 6개월에서"
  },
  {
   "from_": 819,
   "to": 876,
   "text": "5년으로 줄어\n확정됐습니다."
  },
  {
   "from_": 876,
   "to": 901,
   "text": "금고는 징역과 달리"
  },
  {
   "from_": 901,
   "to": 942,
   "text": "노역 의무가 없습니다."
  },
  {
   "from_": 951,
   "to": 989,
   "text": "다음 사건도\n맞혀 보세요."
  }
 ],
