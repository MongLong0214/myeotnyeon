  "subtitles": [
    {
      "start_s": 0.0,
      "end_s": 1.96,
      "text": "노동자를 묶어 지게차로\n들어 올렸습니다.",
      "reference": "노동자를 묶어 지게차로 들어 올렸습니다.",
      "parent": "S1"
    },
    {
      "start_s": 2.1,
      "end_s": 3.18,
      "text": "스리랑카 출신 동료를",
      "reference": "스리랑카 출신 동료를",
      "parent": "S2"
    },
    {
      "start_s": 3.18,
      "end_s": 4.52,
      "text": "약 10m 끌고\n다녔습니다.",
      "reference": "약 10m 끌고 다녔습니다.",
      "parent": "S2"
    },
    {
      "start_s": 4.666666666666667,
      "end_s": 6.5,
      "text": "벽돌 포장 업무가\n서툴다는 이유였습니다.",
      "reference": "벽돌 포장 업무가 서툴다는 이유였습니다.",
      "parent": "S3"
    },
    {
      "start_s": 6.833333333333333,
      "end_s": 9.06,
      "text": "법원은 모멸감과 정신적\n고통을 지적했습니다.",
      "reference": "법원은 모멸감과 정신적 고통을 지적했습니다.",
      "parent": "S4"
    },
    {
      "start_s": 9.166666666666666,
      "end_s": 10.6,
      "text": "반성, 합의, 처벌을 원치\n않는",
      "reference": "반성, 합의, 처벌을 원치 않는",
      "parent": "S5"
    },
    {
      "start_s": 10.6,
      "end_s": 11.34,
      "text": "점도 참작했습니다.",
      "reference": "점도 참작했습니다.",
      "parent": "S5"
    },
    {
      "start_s": 11.533333333333333,
      "end_s": 12.5,
      "text": "합의했다고 형량이",
      "reference": "합의했다고 형량이",
      "parent": "S6"
    },
    {
      "start_s": 12.5,
      "end_s": 13.92,
      "text": "자동으로 정해지는 건\n아닙니다.",
      "reference": "자동으로 정해지는 건 아닙니다.",
      "parent": "S6"
    },
    {
      "start_s": 14.033333333333333,
      "end_s": 15.32,
      "text": "1심 선고는 벌금일까요,",
      "reference": "1심 선고는 벌금일까요,",
      "parent": "S7"
    },
    {
      "start_s": 15.54,
      "end_s": 17.22,
      "text": "집행유예일까요,\n실형일까요? 댓글로",
      "reference": "집행유예일까요, 실형일까요? 댓글로",
      "parent": "S7"
    },
    {
      "start_s": 17.22,
      "end_s": 17.7,
      "text": "골라보세요.",
      "reference": "골라보세요.",
      "parent": "S7"
    },
    {
      "start_s": 17.833333333333332,
      "end_s": 18.84,
      "text": "1심 선고. 징역 1년,",
      "reference": "1심 선고. 징역 1년,",
      "parent": "S8",
      "emphasis": "집행유예 2년"
    },
    {
      "start_s": 18.92,
      "end_s": 20.58,
      "text": "집행유예 2년,\n사회봉사 180시간.",
      "reference": "집행유예 2년, 사회봉사 180시간.",
      "parent": "S8",
      "emphasis": "집행유예 2년"
    },
    {
      "start_s": 20.7,
      "end_s": 22.06,
      "text": "다음 판결도 맞혀보세요.\n구독.",
      "reference": "다음 판결도 맞혀보세요. 구독.",
      "parent": "S9"
    }
  ],
