  "subtitles": [
    {
      "start_s": 0.0,
      "end_s": 2.52,
      "text": "450원짜리 초코파이가\n형사재판까지 갔습니다.",
      "reference": "450원짜리 초코파이가 형사재판까지 갔습니다.",
      "parent": "S1"
    },
    {
      "start_s": 2.7,
      "end_s": 3.72,
      "text": "커스터드 600원까지,",
      "reference": "커스터드 600원까지,",
      "parent": "S2"
    },
    {
      "start_s": 3.72,
      "end_s": 5.12,
      "text": "합쳐서\n1,050원어치입니다.",
      "reference": "합쳐서 1,050원어치입니다.",
      "parent": "S2"
    },
    {
      "start_s": 5.266666666666667,
      "end_s": 6.1,
      "text": "1심은 절도죄로",
      "reference": "1심은 절도죄로",
      "parent": "S3"
    },
    {
      "start_s": 6.1,
      "end_s": 7.36,
      "text": "벌금 5만 원을\n선고했습니다.",
      "reference": "벌금 5만 원을 선고했습니다.",
      "parent": "S3"
    },
    {
      "start_s": 7.633333333333334,
      "end_s": 9.8,
      "text": "피고인은 먹어도 된다는\n말을 들었다고 했습니다.",
      "reference": "피고인은 먹어도 된다는 말을 들었다고 했습니다.",
      "parent": "S4"
    },
    {
      "start_s": 10.033333333333333,
      "end_s": 12.3,
      "text": "동료들도 간식을 나눠 먹던\n관행을 진술했습니다.",
      "reference": "동료들도 간식을 나눠 먹던 관행을 진술했습니다.",
      "parent": "S5"
    },
    {
      "start_s": 12.566666666666666,
      "end_s": 13.36,
      "text": "항소심 쟁점은",
      "reference": "항소심 쟁점은",
      "parent": "S6"
    },
    {
      "start_s": 13.36,
      "end_s": 14.58,
      "text": "훔칠 고의가 있었냐는\n겁니다.",
      "reference": "훔칠 고의가 있었냐는 겁니다.",
      "parent": "S6"
    },
    {
      "start_s": 14.733333333333333,
      "end_s": 15.88,
      "text": "최종 판결은 벌금일까요,",
      "reference": "최종 판결은 벌금일까요,",
      "parent": "S7"
    },
    {
      "start_s": 16.08,
      "end_s": 17.88,
      "text": "선고유예일까요,\n무죄일까요? 댓글로",
      "reference": "선고유예일까요, 무죄일까요? 댓글로",
      "parent": "S7"
    },
    {
      "start_s": 17.88,
      "end_s": 18.36,
      "text": "골라보세요.",
      "reference": "골라보세요.",
      "parent": "S7"
    },
    {
      "start_s": 18.533333333333335,
      "end_s": 20.64,
      "text": "항소심 무죄. 검찰\n상고 포기로 확정됐습니다.",
      "reference": "항소심 무죄. 검찰 상고 포기로 확정됐습니다.",
      "parent": "S8",
      "emphasis": "무죄"
    },
    {
      "start_s": 20.8,
      "end_s": 22.18,
      "text": "다음 판결도 맞혀보세요.\n구독.",
      "reference": "다음 판결도 맞혀보세요. 구독.",
      "parent": "S9"
    }
  ],
