  "subtitles": [
    {
      "start_s": 0.0,
      "end_s": 2.3,
      "text": "달리는 지하철 안에 휘발유를 붓고 불을 질렀습니다.",
      "reference": "달리는 지하철 안에 휘발유를 붓고 불을 질렀습니다."
    },
    {
      "start_s": 2.38,
      "end_s": 3.12,
      "text": "징역 몇 년일까요?",
      "reference": "징역 몇 년일까요?"
    },
    {
      "start_s": 3.24,
      "end_s": 4.22,
      "text": "서울 지하철 5호선.",
      "reference": "서울 지하철 오호선."
    },
    {
      "start_s": 4.22,
      "end_s": 6.9,
      "text": "불길이 번지자 승객들은 대피했고, 연기를 마신 사람도",
      "reference": "불길이 번지자 승객들은 대피했고, 연기를 마신 사람도"
    },
    {
      "start_s": 6.9,
      "end_s": 7.36,
      "text": "나왔습니다.",
      "reference": "나왔습니다."
    },
    {
      "start_s": 7.466666666666667,
      "end_s": 10.38,
      "text": "검찰은 승객 160 명에 대한 살인미수 혐의도 적용했습니다.",
      "reference": "검찰은 승객 백육십 명에 대한 살인미수 혐의도 적용했습니다."
    },
    {
      "start_s": 10.56,
      "end_s": 11.9,
      "text": "실제 사망자 수가 아닙니다.",
      "reference": "실제 사망자 수가 아닙니다."
    },
    {
      "start_s": 11.98,
      "end_s": 13.44,
      "text": "검찰 구형은 징역 20년.",
      "reference": "검찰 구형은 징역 이십 년."
    },
    {
      "start_s": 13.44,
      "end_s": 15.02,
      "text": "그런데 실제 선고는 달랐습니다.",
      "reference": "그런데 실제 선고는 달랐습니다."
    },
    {
      "start_s": 15.12,
      "end_s": 16.88,
      "text": "피해 회복도 대부분 이뤄지지 않았습니다.",
      "reference": "피해 회복도 대부분 이뤄지지 않았습니다."
    },
    {
      "start_s": 17.02,
      "end_s": 19.7,
      "text": "재판부는 대중교통의 안전에 대한 신뢰까지 해쳤다고",
      "reference": "재판부는 대중교통의 안전에 대한 신뢰까지 해쳤다고"
    },
    {
      "start_s": 19.7,
      "end_s": 20.34,
      "text": "지적했습니다.",
      "reference": "지적했습니다."
    },
    {
      "start_s": 20.48,
      "end_s": 21.8,
      "text": "항소심도 유지한 형량은?",
      "reference": "항소심도 유지한 형량은?"
    },
    {
      "start_s": 21.866666666666667,
      "end_s": 23.24,
      "text": "항소심 선고, 징역 12년.",
      "reference": "항소심 선고, 징역 십이 년."
    },
    {
      "start_s": 23.24,
      "end_s": 24.22,
      "text": "보호관찰 3년입니다.",
      "reference": "보호관찰 삼 년입니다."
    },
    {
      "start_s": 24.366666666666667,
      "end_s": 25.48,
      "text": "다음 판결도 맞혀보세요.",
      "reference": "다음 판결도 맞혀보세요."
    },
    {
      "start_s": 25.6,
      "end_s": 25.74,
      "text": "구독.",
      "reference": "구독."
    }
