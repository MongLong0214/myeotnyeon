{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "factory/schema/episode.schema.json",
 "title": "Shorts episode spec (the only file an operator writes per episode)",
 "description": "Everything visual is chosen by enum from factory/shorts/library.json. Numbers on screen come from facts[].values through pops[].vars; never type a number into a pop template. Fixed beats (choices, options, answer, opinion) are generated by the builder.",
 "type": "object",
 "additionalProperties": false,
 "required": [
  "spec_version",
  "id",
  "locale",
  "variant",
  "channel",
  "sources",
  "facts",
  "title",
  "description",
  "hashtags",
  "lines"
 ],
 "properties": {
  "spec_version": {
   "const": 1
  },
  "id": {
   "type": "string",
   "pattern": "^(q|en|ja|bc|zz[a-z]{1,3})[0-9]{3}$",
   "description": "q=ko, en, ja, bc=Beast Clash; zz* = evaluation builds that are never uploaded"
  },
  "locale": {
   "enum": [
    "ko",
    "en",
    "ja"
   ]
  },
  "variant": {
   "enum": [
    "B3",
    "BC"
   ]
  },
  "channel": {
   "enum": [
    "myeotnyeon",
    "guessthesentence",
    "nannenderu",
    "beastclash"
   ]
  },
  "case": {
   "$ref": "#/$defs/case"
  },
  "sources": {
   "type": "array",
   "minItems": 2,
   "maxItems": 6,
   "items": {
    "$ref": "#/$defs/source"
   }
  },
  "facts": {
   "type": "array",
   "minItems": 2,
   "maxItems": 10,
   "items": {
    "$ref": "#/$defs/fact"
   }
  },
  "title": {
   "type": "string",
   "minLength": 8,
   "maxLength": 60
  },
  "description": {
   "type": "string",
   "minLength": 80,
   "maxLength": 1400,
   "description": "fact paragraphs only; disclaimer, TTS credit, hashtags and sources are appended by the builder"
  },
  "hashtags": {
   "type": "array",
   "minItems": 3,
   "maxItems": 6,
   "items": {
    "type": "string",
    "pattern": "^#[^\\s#]{1,30}$"
   }
  },
  "cover": {
   "type": "string",
   "minLength": 4,
   "maxLength": 30,
   "description": "thumbnail text, at most 2 lines joined by \\n"
  },
  "hook": {
   "type": "array",
   "minItems": 2,
   "maxItems": 2,
   "items": {
    "type": "string",
    "minLength": 2,
    "maxLength": 24
   },
   "description": "[small line, big red line] shown over the first line"
  },
  "stage": {
   "$ref": "#/$defs/stage"
  },
  "stage_day": {
   "type": "boolean",
   "description": "cash stage only: daytime palette (default night). Use when the source says the event happened in daylight."
  },
  "defendant": {
   "$ref": "#/$defs/look"
  },
  "quiz": {
   "$ref": "#/$defs/quiz"
  },
  "lines": {
   "type": "array",
   "minItems": 7,
   "maxItems": 14,
   "items": {
    "$ref": "#/$defs/line"
   }
  },
  "pops": {
   "type": "array",
   "maxItems": 6,
   "items": {
    "$ref": "#/$defs/pop"
   }
  },
  "bc": {
   "$ref": "#/$defs/bc"
  },
  "notes": {
   "type": "string",
   "maxLength": 600
  },
  "format": {
   "enum": [
    "quiz",
    "result_first"
   ],
   "description": "quiz (default): A/B/C board + answer line. result_first (format B): sentence in the frame-0 hook caption, no board, answer2 = sentence card"
  },
  "pinned": {
   "type": "string",
   "minLength": 1,
   "description": "meta.txt pinned comment; default: the ending card text (result_first: write a one-line factual summary)"
  }
 },
 "allOf": [
  {
   "if": {
    "properties": {
     "variant": {
      "const": "B3"
     }
    }
   },
   "then": {
    "required": [
     "stage",
     "defendant",
     "pops",
     "case",
     "quiz",
     "hook",
     "cover"
    ]
   }
  },
  {
   "if": {
    "properties": {
     "variant": {
      "const": "BC"
     }
    }
   },
   "then": {
    "required": [
     "bc"
    ]
   }
  }
 ],
 "$defs": {
  "stage": {
   "enum": [
    "deal",
    "kick",
    "motel",
    "taxi",
    "fire",
    "kettle",
    "bb",
    "flee",
    "forge",
    "vault",
    "soju",
    "cab",
    "bus",
    "salt",
    "printshop",
    "glare",
    "busargue",
    "scan",
    "stream",
    "shots",
    "cash",
    "speed",
    "like",
    "voucher",
    "bank",
    "factory",
    "pledge",
    "yard",
    "holiday",
    "bar"
   ]
  },
  "look": {
   "enum": [
    "B",
    "A",
    "chair",
    "judge",
    "cop",
    "D",
    "suit",
    "hoodie",
    "clerk",
    "granny",
    "doctor",
    "passenger",
    "driver",
    "snack",
    "migrant",
    "official",
    "sweeper",
    "sweeper2",
    "sweeper3",
    "inmate",
    "attacker",
    "inmate2",
    "rich",
    "prof",
    "woman",
    "lady"
   ]
  },
  "expr": {
   "enum": [
    "pain",
    "concern",
    "normal",
    "angry",
    "shock",
    "scared",
    "tired",
    "smug",
    "serious",
    "dizzy"
   ]
  },
  "case": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "category",
    "grave",
    "deaths",
    "victim_minor",
    "sexual_offence",
    "court",
    "instance",
    "finality",
    "verdict_date",
    "sentence_fact"
   ],
   "properties": {
    "category": {
     "enum": [
      "fraud",
      "embezzlement",
      "theft",
      "assault",
      "traffic",
      "drunk_driving",
      "animal_cruelty",
      "labor_abuse",
      "workplace_accident",
      "arson",
      "homicide",
      "drugs",
      "stalking",
      "other"
     ]
    },
    "grave": {
     "type": "boolean",
     "description": "true for deaths or serious injury: no gags, no anger marks, no subscribe gag"
    },
    "deaths": {
     "type": "integer",
     "minimum": 0
    },
    "victim_minor": {
     "type": "boolean",
     "description": "must be false (policy)"
    },
    "sexual_offence": {
     "type": "boolean",
     "description": "must be false (policy)"
    },
    "court": {
     "type": "string",
     "minLength": 2,
     "maxLength": 20,
     "description": "shown on the answer card, e.g. 부산지법 / Superior Court"
    },
    "instance": {
     "enum": [
      "1심",
      "2심",
      "대법원",
      "심급 미표기",
      "first_instance",
      "appeal",
      "supreme"
     ]
    },
    "finality": {
     "enum": [
      "확정",
      "항소 미확인",
      "항소",
      "상고 미확인",
      "상고",
      "final",
      "appeal_unknown",
      "appealed",
      "not_final"
     ]
    },
    "verdict_date": {
     "type": "string",
     "pattern": "^(20[0-9]{2}-[01][0-9]-[0-3][0-9]|unknown)$",
     "description": "the date the sentence was handed down, as a quote or source text writes it; \"unknown\" when the sources give only a report date"
    },
    "sentence_fact": {
     "type": "string",
     "pattern": "^F[0-9]{1,2}$",
     "description": "fact id whose quote states the sentence"
    }
   }
  },
  "source": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "id",
    "outlet",
    "url"
   ],
   "properties": {
    "id": {
     "type": "string",
     "pattern": "^S[0-9]$"
    },
    "outlet": {
     "type": "string",
     "minLength": 2,
     "maxLength": 40
    },
    "url": {
     "type": "string",
     "pattern": "^https?://[^\\s]+$"
    },
    "published": {
     "type": "string",
     "pattern": "^20[0-9]{2}-[01][0-9]-[0-3][0-9]$"
    }
   }
  },
  "fact": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "id",
    "claim",
    "quotes"
   ],
   "properties": {
    "id": {
     "type": "string",
     "pattern": "^F[0-9]{1,2}$"
    },
    "claim": {
     "type": "string",
     "minLength": 8,
     "maxLength": 300
    },
    "quotes": {
     "type": "array",
     "minItems": 1,
     "maxItems": 4,
     "items": {
      "type": "object",
      "additionalProperties": false,
      "required": [
       "source",
       "text"
      ],
      "properties": {
       "source": {
        "type": "string",
        "pattern": "^S[0-9]$"
       },
       "text": {
        "type": "string",
        "minLength": 6,
        "maxLength": 300,
        "description": "copied verbatim from the article"
       }
      }
     }
    },
    "values": {
     "type": "object",
     "maxProperties": 8,
     "propertyNames": {
      "pattern": "^[a-z][a-z0-9_]{0,15}$"
     },
     "additionalProperties": {
      "type": "object",
      "additionalProperties": false,
      "required": [
       "kind",
       "text"
      ],
      "properties": {
       "kind": {
        "enum": [
         "amount",
         "count",
         "date",
         "duration",
         "measure"
        ]
       },
       "text": {
        "type": "string",
        "minLength": 1,
        "maxLength": 40,
        "description": "exactly as written in one of this fact's quotes"
       }
      }
     }
    }
   }
  },
  "quiz": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "choices",
    "answer"
   ],
   "properties": {
    "choices": {
     "type": "array",
     "minItems": 3,
     "maxItems": 3,
     "uniqueItems": true,
     "items": {
      "type": "string",
      "minLength": 2,
      "maxLength": 20
     }
    },
    "answer": {
     "type": "integer",
     "minimum": 0,
     "maximum": 2
    },
    "answer_text": {
     "type": "string",
     "minLength": 2,
     "maxLength": 20,
     "description": "optional longer wording of the correct choice for the answer line (default: the choice itself)"
    }
   }
  },
  "line": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "beat",
    "text",
    "fact"
   ],
   "properties": {
    "beat": {
     "enum": [
      "open",
      "hook",
      "guess",
      "twist",
      "fact",
      "answer2",
      "loop",
      "face",
      "stat",
      "prompt",
      "clash",
      "verdict"
     ],
     "description": "B3 order: open, hook, guess, twist, fact x1-4, answer2, loop. BC order: face, stat x3, prompt, clash x2-5, verdict x1-2, loop"
    },
    "text": {
     "type": "string",
     "minLength": 2,
     "maxLength": 64,
     "description": "what the subtitle shows; numbers as digits"
    },
    "say": {
     "type": "string",
     "minLength": 2,
     "maxLength": 80,
     "description": "optional spoken form; default is generated from text"
    },
    "actor": {
     "$ref": "#/$defs/look",
     "description": "who the line is about; required when a shot is react or cell"
    },
    "fact": {
     "type": "string",
     "pattern": "^F[0-9]{1,2}$"
    },
    "emphasis": {
     "type": "string",
     "minLength": 1,
     "maxLength": 20
    },
    "sfx": {
     "enum": [
      "thud",
      "clank",
      "knock",
      "whoosh"
     ]
    },
    "shots": {
     "type": "array",
     "maxItems": 3,
     "items": {
      "$ref": "#/$defs/shot"
     },
     "description": "1-2 shots; up to 3 with \"format\": \"result_first\" (checked in compile)"
    }
   }
  },
  "shot": {
   "type": "object",
   "required": [
    "scene"
   ],
   "properties": {
    "scene": {
     "enum": [
      "stage",
      "react",
      "cell",
      "judge",
      "prosecutor",
      "calendar",
      "bubble",
      "paper",
      "stamp",
      "tally",
      "money",
      "phone",
      "charge",
      "rear",
      "strike",
      "impact",
      "retreat"
     ]
    }
   },
   "allOf": [
    {
     "if": {
      "properties": {
       "scene": {
        "enum": [
         "stage",
         "judge",
         "prosecutor"
        ]
       }
      }
     },
     "then": {
      "additionalProperties": false,
      "properties": {
       "scene": {}
      }
     }
    },
    {
     "if": {
      "properties": {
       "scene": {
        "const": "react"
       }
      }
     },
     "then": {
      "additionalProperties": false,
      "required": [
       "expr",
       "move"
      ],
      "properties": {
       "scene": {},
       "look": {
        "$ref": "#/$defs/look"
       },
       "expr": {
        "$ref": "#/$defs/expr"
       },
       "move": {
        "enum": [
         "nod",
         "shake",
         "recoil",
         "shrug"
        ]
       },
       "framing": {
        "enum": [
         "close"
        ],
        "description": "close only: a lower body puts the chin under the subtitles (render.cjs SUBTITLE OVER FACE)"
       },
       "other": {
        "type": "boolean",
        "description": "true only when the shown look is deliberately not the line actor (e.g. a victim reacting)"
       }
      }
     }
    },
    {
     "if": {
      "properties": {
       "scene": {
        "const": "cell"
       }
      }
     },
     "then": {
      "additionalProperties": false,
      "required": [
       "expr"
      ],
      "properties": {
       "scene": {},
       "look": {
        "$ref": "#/$defs/look"
       },
       "expr": {
        "enum": [
         "concern",
         "shock",
         "tired"
        ]
       }
      }
     }
    },
    {
     "if": {
      "properties": {
       "scene": {
        "const": "calendar"
       }
      }
     },
     "then": {
      "additionalProperties": false,
      "required": [
       "date"
      ],
      "properties": {
       "scene": {},
       "date": {
        "type": "string",
        "pattern": "^F[0-9]{1,2}\\.[a-z][a-z0-9_]*$",
        "description": "a date value, e.g. F1.start"
       }
      }
     }
    },
    {
     "if": {
      "properties": {
       "scene": {
        "const": "bubble"
       }
      }
     },
     "then": {
      "additionalProperties": false,
      "required": [
       "lines"
      ],
      "properties": {
       "scene": {},
       "lines": {
        "type": "array",
        "minItems": 1,
        "maxItems": 2,
        "items": {
         "type": "string",
         "minLength": 1,
         "maxLength": 14
        }
       }
      }
     }
    },
    {
     "if": {
      "properties": {
       "scene": {
        "const": "paper"
       }
      }
     },
     "then": {
      "additionalProperties": false,
      "required": [
       "lines"
      ],
      "properties": {
       "scene": {},
       "lines": {
        "type": "array",
        "minItems": 1,
        "maxItems": 3,
        "items": {
         "type": "string",
         "minLength": 1,
         "maxLength": 16
        }
       }
      }
     }
    },
    {
     "if": {
      "properties": {
       "scene": {
        "const": "stamp"
       }
      }
     },
     "then": {
      "additionalProperties": false,
      "required": [
       "label",
       "stamp"
      ],
      "properties": {
       "scene": {},
       "label": {
        "type": "string",
        "minLength": 1,
        "maxLength": 14
       },
       "stamp": {
        "type": "string",
        "minLength": 1,
        "maxLength": 8
       }
      }
     }
    },
    {
     "if": {
      "properties": {
       "scene": {
        "const": "tally"
       }
      }
     },
     "then": {
      "additionalProperties": false,
      "required": [
       "count",
       "label"
      ],
      "properties": {
       "scene": {},
       "count": {
        "type": "string",
        "pattern": "^F[0-9]{1,2}\\.[a-z][a-z0-9_]*$",
        "description": "a count value, e.g. F3.count (max 15)"
       },
       "label": {
        "type": "string",
        "minLength": 1,
        "maxLength": 12
       }
      }
     }
    },
    {
     "if": {
      "properties": {
       "scene": {
        "const": "money"
       }
      }
     },
     "then": {
      "additionalProperties": false,
      "properties": {
       "scene": {},
       "bundles": {
        "type": "integer",
        "minimum": 1,
        "maximum": 3
       }
      }
     }
    },
    {
     "if": {
      "properties": {
       "scene": {
        "const": "phone"
       }
      }
     },
     "then": {
      "additionalProperties": false,
      "required": [
       "msgs"
      ],
      "properties": {
       "scene": {},
       "msgs": {
        "type": "array",
        "minItems": 1,
        "maxItems": 3,
        "items": {
         "type": "string",
         "minLength": 1,
         "maxLength": 12
        }
       }
      }
     }
    },
    {
     "if": {
      "properties": {
       "scene": {
        "enum": [
         "charge",
         "rear",
         "strike",
         "impact",
         "retreat"
        ]
       }
      }
     },
     "then": {
      "additionalProperties": false,
      "required": [
       "who"
      ],
      "properties": {
       "scene": {},
       "who": {
        "enum": [
         "a",
         "b"
        ]
       },
       "tank": {
        "type": "boolean"
       },
       "pin": {
        "type": "boolean"
       }
      }
     }
    }
   ]
  },
  "pop": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "beat",
    "at",
    "big",
    "small",
    "vars"
   ],
   "properties": {
    "beat": {
     "type": "string",
     "pattern": "^(hook|guess|twist|fact[1-4]|answer2)$"
    },
    "at": {
     "type": "number",
     "minimum": 0,
     "maximum": 0.9,
     "description": "position inside the line, 0..0.9"
    },
    "big": {
     "type": "string",
     "minLength": 1,
     "maxLength": 30,
     "description": "template; numbers only through {var}"
    },
    "small": {
     "type": "string",
     "maxLength": 34
    },
    "vars": {
     "type": "object",
     "maxProperties": 4,
     "additionalProperties": {
      "type": "string",
      "minLength": 3,
      "maxLength": 60,
      "description": "F2.loan | F2.loan - F2.request | span(F1.start, F1.end) | months(F4.sentence) | days(F4.sentence) | hours(F5.jail)"
     }
    }
   }
  },
  "bc": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "a",
    "b",
    "winner",
    "bg",
    "stats",
    "verdict"
   ],
   "properties": {
    "a": {
     "enum": [
      "polar",
      "walrus",
      "jaguar",
      "anaconda",
      "badger",
      "cobra",
      "orca",
      "shark",
      "elephant",
      "rhino",
      "hippo",
      "croc"
     ]
    },
    "b": {
     "enum": [
      "polar",
      "walrus",
      "jaguar",
      "anaconda",
      "badger",
      "cobra",
      "orca",
      "shark",
      "elephant",
      "rhino",
      "hippo",
      "croc"
     ]
    },
    "winner": {
     "enum": [
      "a",
      "b"
     ]
    },
    "bg": {
     "enum": [
      "ice",
      "jungle",
      "scrub",
      "ocean",
      "savanna",
      "river"
     ]
    },
    "voice": {
     "enum": [
      "af_bella",
      "af_heart",
      "am_adam",
      "am_michael"
     ]
    },
    "stats": {
     "type": "array",
     "minItems": 3,
     "maxItems": 3,
     "items": {
      "type": "object",
      "additionalProperties": false,
      "required": [
       "label",
       "win"
      ],
      "properties": {
       "label": {
        "type": "string",
        "minLength": 2,
        "maxLength": 12
       },
       "a": {
        "type": "string",
        "pattern": "^F[0-9]{1,2}\\.[a-z][a-z0-9_]*$"
       },
       "b": {
        "type": "string",
        "pattern": "^F[0-9]{1,2}\\.[a-z][a-z0-9_]*$"
       },
       "win": {
        "enum": [
         "a",
         "b"
        ]
       },
       "a_cond": {
        "type": "string",
        "minLength": 2,
        "maxLength": 22,
        "description": "condition shown under this side's number on the card, e.g. RECORD INDIVIDUAL, HEAVIEST SPECIES, UP TO (CEO bc006)"
       },
       "b_cond": {
        "type": "string",
        "minLength": 2,
        "maxLength": 22,
        "description": "condition shown under this side's number on the card, e.g. RECORD INDIVIDUAL, HEAVIEST SPECIES, UP TO (CEO bc006)"
       }
      }
     }
    },
    "verdict": {
     "type": "object",
     "additionalProperties": false,
     "required": [
      "note",
