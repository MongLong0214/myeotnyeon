# Text/code allowlist: everything else, including unknown binary formats, stays local.
*
!*/
!*.py
!*.ts
!*.tsx
!*.js
!*.cjs
!*.mjs
!*.json
!*.md
!*.txt
!*.csv
!*.jsonl
!*.sh
!*.toml
!*.yaml
!*.yml
!*.ini
!*.cfg
!*.conf
!*.config
!*.lock
!*.css
!*.html
!*.swift
!*.tsv
!*.srt
!*.vtt
!*.ass
!Dockerfile
!Makefile
!Procfile
!.gitignore
!.gitattributes
!.editorconfig
!.npmrc
!.nvmrc
!.python-version

# Media / archives / models (case-insensitive; allowlist also rejects unknown types).
*.[mM][pP]4
*.[mM][oO][vV]
*.[wW][aA][vV]
*.[mM][pP]3
*.[mM]4[aA]
*.[aA][aA][cC]
*.[fF][lL][aA][cC]
*.[pP][nN][gG]
*.[jJ][pP][gG]
*.[jJ][pP][eE][gG]
*.[wW][eE][bB][pP]
*.[gG][iI][fF]
*.[zZ][iI][pP]
*.[nN][pP][zZ]
*.[pP][tT]
*.[bB][iI][nN]
*.[oO][nN][nN][xX]
*.[sS][aA][fF][eE][tT][eE][nN][sS][oO][rR][sS]

# Dependencies, caches and generated output; source files named render_*.py remain eligible.
node_modules/
.venv/
venv/
__pycache__/
.cache/
cache/
caches/
models/
checkpoints/
out/
renders/
bundle/
bundle*/
frames/
tmp/
.tmp/
_work/
render_*/
render_*.json
render_*.jsonl
render_*.txt
render_*.md
render_*.csv
render_*.html
dist/
build/
.next/
.remotion/
review_runs/**/images/
.bak_*/

# Credential containers; originals stay untouched. Never force-add these.
.env
.env.*
*.pem
*.key
*.p12
*.pfx
*credentials*.json
*cookies*.json
*cookies*.txt
*token*.json
*naver*key*
*naver*secret*

# Independently managed repository and active full-film writers: do not traverse or stage.
/research/tools/stickman-video-director/
/tts_lab/engines/melotts/src/
/production/lf_toon/
/episodes/review_full/

