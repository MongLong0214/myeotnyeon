 "subtitles": [
  {
   "from_": 4,
   "to": 29,
   "text": "도심 역주행 사고로"
  },
  {
   "from_": 29,
   "to": 67,
   "text": "9명이 숨졌습니다."
  },
  {
   "from_": 76,
   "to": 118,
   "text": "운전자는 급발진을\n주장했지만"
  },
  {
   "from_": 118,
   "to": 172,
   "text": "법원은 받아들이지\n않았죠."
  },
  {
   "from_": 172,
   "to": 204,
   "text": "급발진에서 나타날 신호는"
  },
  {
   "from_": 204,
   "to": 235,
   "text": "없다고 봤습니다."
  },
  {
   "from_": 244,
   "to": 264,
   "text": "1심과 2심은"
  },
  {
   "from_": 264,
   "to": 343,
   "text": "여러 피해를 어떻게\n처벌할지 달리 봤습니다."
  },
  {
   "from_": 343,
   "to": 391,
   "text": "1심은 인도와 차량 충돌 사고를"
  },
  {
   "from_": 391,
   "to": 443,
   "text": "각각 별개의 행위로 봤죠."
  },
  {
   "from_": 461,
   "to": 526,
   "text": "벌금, 집행유예, 실형 중\n무엇이었을까요?"
  },
  {
   "from_": 526,
   "to": 582,
   "text": "2심은 하나의 운전행위로\n봤습니다."
  },
  {
   "from_": 582,
   "to": 604,
   "text": "한 번의 운전으로"
  },
  {
   "from_": 604,
   "to": 655,
   "text": "여러 죄가 성립한\n경우였죠."
  },
  {
   "from_": 655,
   "to": 720,
   "text": "가장 무거운 죄에\n정해진 형으로 처벌합니다."
  },
  {
   "from_": 741,
   "to": 761,
   "text": "실형."
  },
  {
   "from_": 761,
   "to": 791,
   "text": "금고 7년 6개월에서"
  },
  {
   "from_": 791,
   "to": 848,
   "text": "5년으로 줄어\n확정됐습니다."
  },
  {
   "from_": 848,
   "to": 873,
   "text": "금고는 징역과 달리"
  },
  {
   "from_": 873,
   "to": 914,
   "text": "노역 의무가 없습니다."
  },
  {
   "from_": 923,
   "to": 961,
   "text": "다음 사건도\n맞혀 보세요."
  }
 ],
