 "subtitles": [
  {
   "from_": 4,
   "to": 32,
   "text": "새벽 4시,"
  },
  {
   "from_": 32,
   "to": 78,
   "text": "한 물류회사\n사무실 냉장고에서"
  },
  {
   "from_": 78,
   "to": 149,
   "text": "초코파이와 과자를\n꺼내 먹은 40대가,"
  },
  {
   "from_": 149,
   "to": 207,
   "text": "절도죄로\n재판을 받았습니다."
  },
  {
   "from_": 216,
   "to": 278,
   "text": "이 사람은 먹어도\n된다는 말을 들었다며,"
  },
  {
   "from_": 278,
   "to": 321,
   "text": "정식 재판까지\n청구했죠."
  },
  {
   "from_": 330,
   "to": 340,
   "text": "자,"
  },
  {
   "from_": 340,
   "to": 366,
   "text": "몇 년 받았을까요?"
  },
  {
   "from_": 366,
   "to": 388,
   "text": "벌금일까요,"
  },
  {
   "from_": 388,
   "to": 414,
   "text": "집행유예일까요,"
  },
  {
   "from_": 414,
   "to": 443,
   "text": "아니면 실형일까요?"
  },
  {
   "from_": 542,
   "to": 563,
   "text": "1심 정답은,"
  },
  {
   "from_": 563,
   "to": 584,
   "text": "벌금 5만 원."
  },
  {
   "from_": 584,
   "to": 608,
   "text": "유죄였습니다."
  },
  {
   "from_": 623,
   "to": 668,
   "text": "그런데 2심에서\n뒤집혔어요."
  },
  {
   "from_": 668,
   "to": 730,
   "text": "먹어도 된다고 믿을\n만했다며, 무죄."
  },
  {
   "from_": 742,
   "to": 778,
   "text": "다음 사건도\n맞혀 보세요."
  }
 ],
 "audio": "q004/mix_master.wav"
