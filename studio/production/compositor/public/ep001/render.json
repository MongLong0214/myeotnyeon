 ],
 "subtitles": [
  {
   "from_": 14,
   "to": 44,
   "text": "2022년 여름,"
  },
  {
   "from_": 44,
   "to": 74,
   "text": "새벽 3시 반."
  },
  {
   "from_": 74,
   "to": 117,
   "text": "대구의 한 주차장에서,"
  },
  {
   "from_": 117,
   "to": 170,
   "text": "한 사람이 차 앞을 막아섭니다."
  },
  {
   "from_": 182,
   "to": 238,
   "text": "음주운전으로 신고하겠다는 거였죠."
  },
  {
   "from_": 238,
   "to": 268,
   "text": "그런데 운전자는,"
  },
  {
   "from_": 268,
   "to": 317,
   "text": "그 사람을 차로 밀어 버립니다."
  },
  {
   "from_": 317,
   "to": 340,
   "text": "그것도 여러 번."
  },
  {
   "from_": 355,
   "to": 430,
   "text": "법원도 진지하게 반성한다고\n볼 수 없다고 했어요."
  },
  {
   "from_": 430,
   "to": 471,
   "text": "그런데 결과는, 집행유예."
  },
  {
   "from_": 471,
   "to": 489,
   "text": "왜일까요?"
  },
  {
   "from_": 612,
   "to": 698,
   "text": "당시 커뮤니티에서 '역대급\n판결'로 불렸던 사건이에요."
  },
  {
   "from_": 698,
   "to": 734,
   "text": "2023년 8월,"
  },
  {
   "from_": 734,
   "to": 792,
   "text": "대구지방법원의 1심 판결입니다."
  },
  {
   "from_": 807,
   "to": 849,
   "text": "등장인물은 두 사람이에요."
  },
  {
   "from_": 849,
   "to": 877,
   "text": "차를 몬 A씨,"
  },
  {
   "from_": 877,
   "to": 929,
   "text": "그리고 차 앞을 막아선 B씨."
  },
  {
   "from_": 929,
   "to": 997,
   "text": "원래 아는 사이였는지는\n보도에 나오지 않아요."
  },
  {
   "from_": 1012,
   "to": 1061,
   "text": "B씨가 차 앞을 막아서자,"
  },
  {
   "from_": 1061,
   "to": 1133,
   "text": "A씨는 차로 B씨를 밀기 시작합니다."
  },
  {
   "from_": 1133,
   "to": 1169,
   "text": "한 번이 아니라 여러 번."
  },
  {
   "from_": 1169,
   "to": 1205,
   "text": "결국 B씨는 넘어졌어요."
  },
  {
   "from_": 1217,
   "to": 1275,
   "text": "그런데 A씨는 차를 뒤로 뺐다가,"
  },
  {
   "from_": 1275,
   "to": 1358,
   "text": "다시 앞으로 몰아 B씨를\n한 번 더 들이받았습니다."
  },
  {
   "from_": 1370,
   "to": 1466,
   "text": "B씨는 약 34일 치료가\n필요한 어깨 부상을 입었어요."
  },
  {
   "from_": 1481,
   "to": 1530,
   "text": "A씨 측 주장은 달랐어요."
  },
  {
   "from_": 1530,
   "to": 1567,
   "text": "부주의한 운전 탓이다,"
  },
  {
   "from_": 1567,
   "to": 1606,
   "text": "B씨가 차에 뛰어든 거다."
  },
  {
   "from_": 1618,
   "to": 1683,
   "text": "들이받은 것 자체는 A씨도 인정했어요."
  },
  {
   "from_": 1683,
   "to": 1709,
   "text": "다툼은 두 가지."
  },
  {
   "from_": 1709,
   "to": 1734,
   "text": "일부러 그랬나,"
  },
  {
   "from_": 1734,
   "to": 1771,
   "text": "그리고 그것 때문에 다쳤나."
  },
  {
   "from_": 1792,
   "to": 1847,
   "text": "재판에 넘겨진 죄명은 특수상해."
  },
  {
   "from_": 1847,
   "to": 1920,
   "text": "위험한 물건으로 사람을\n다치게 한 죄인데,"
  },
  {
   "from_": 1920,
   "to": 1996,
   "text": "판례상 자동차도 위험한\n물건이 될 수 있어요."
  },
  {
   "from_": 2008,
   "to": 2087,
   "text": "법이 정한 형은 징역\n1년 이상 10년 이하."
  },
  {
   "from_": 2087,
   "to": 2131,
   "text": "벌금으로는 끝낼 수 없는 죄예요."
  },
  {
   "from_": 2143,
   "to": 2257,
   "text": "참고로 커뮤니티에선 음주운전이\n확정된 사실처럼 퍼졌는데요."
  },
  {
   "from_": 2257,
   "to": 2282,
   "text": "보도된 죄명은,"
  },
  {
   "from_": 2282,
   "to": 2320,
   "text": "특수상해 딱 하나예요."
  },
  {
   "from_": 2320,
   "to": 2370,
   "text": "음주 측정 결과도 보도된 적 없고요."
  },
  {
   "from_": 2388,
   "to": 2431,
   "text": "법원은 유죄를 인정했어요."
  },
  {
   "from_": 2431,
   "to": 2463,
   "text": "그럼 오늘의 질문."
  },
  {
   "from_": 2463,
   "to": 2494,
   "text": "반성도 없다면서,"
  },
  {
   "from_": 2494,
   "to": 2531,
   "text": "왜 실형이 아니었을까?"
  },
  {
   "from_": 2564,
   "to": 2578,
   "text": "먼저,"
  },
  {
   "from_": 2578,
   "to": 2623,
   "text": "유죄인지 아닌지부터 볼게요."
  },
  {
   "from_": 2623,
   "to": 2672,
   "text": "핵심은 현장 CCTV였어요."
  },
  {
   "from_": 2672,
   "to": 2719,
   "text": "판결을 전한 보도에 따르면,"
  },
  {
   "from_": 2719,
   "to": 2782,
   "text": "범행 장면이 그대로 녹화돼 있었거든요."
  },
  {
   "from_": 2794,
   "to": 2854,
   "text": "A씨 측은 들이받은 건 맞지만,"
  },
  {
   "from_": 2854,
   "to": 2966,
   "text": "B씨가 다치지 않았거나 그 행동\n때문에 다친 건 아니라고 했어요."
  },
  {
   "from_": 2978,
   "to": 3034,
   "text": "그 부분을 가른 건 진료기록이었어요."
  },
  {
   "from_": 3034,
   "to": 3104,
   "text": "B씨는 사건 다음 날부터 8월 말까지,"
  },
  {
   "from_": 3104,
   "to": 3184,
   "text": "그리고 이듬해 5월쯤까지\n치료를 받았어요."
  },
  {
   "from_": 3199,
   "to": 3235,
   "text": "법원의 첫 번째 답은,"
  },
  {
   "from_": 3235,
   "to": 3287,
   "text": "일부러 한 게 맞다는 거예요."
  },
  {
   "from_": 3287,
   "to": 3340,
   "text": "CCTV로 고의가 인정되고,"
  },
  {
   "from_": 3340,
   "to": 3430,
   "text": "B씨가 일부러 뛰어든 것으로는\n보이지 않는다고 했어요."
  },
  {
   "from_": 3442,
   "to": 3464,
   "text": "두 번째 답은,"
  },
  {
   "from_": 3464,
   "to": 3507,
   "text": "다친 것도 맞다는 거였어요."
  },
  {
   "from_": 3507,
   "to": 3560,
   "text": "차로 민 힘이 가볍지 않았고,"
  },
  {
   "from_": 3560,
   "to": 3641,
   "text": "진료기록도 B씨 말과 어느\n정도 맞는다는 거죠."
  },
  {
   "from_": 3653,
   "to": 3677,
   "text": "그래서 결론은,"
  },
  {
   "from_": 3677,
   "to": 3710,
   "text": "특수상해 유죄였습니다."
  },
  {
   "from_": 3737,
   "to": 3777,
   "text": "이제 남은 건 형량이에요."
  },
  {
   "from_": 3777,
   "to": 3821,
   "text": "실형이냐, 집행유예냐."
  },
  {
   "from_": 3821,
   "to": 3868,
   "text": "여러분이 판사라면 어느 쪽이세요?"
  },
  {
   "from_": 3916,
   "to": 3958,
   "text": "대구지방법원의 판단은,"
  },
  {
   "from_": 3958,
   "to": 4013,
   "text": "징역 8개월에 집행유예 2년."
  },
  {
   "from_": 4013,
   "to": 4050,
   "text": "사회봉사 120시간."
  },
  {
   "from_": 4098,
   "to": 4122,
   "text": "쉽게 말해,"
  },
  {
   "from_": 4122,
   "to": 4189,
   "text": "징역 8개월을 2년\n동안 미뤄 둔 거예요."
  },
  {
   "from_": 4189,
   "to": 4258,
   "text": "그사이 고의로 죄를\n지어 실형이 확정되면,"
  },
  {
   "from_": 4258,
   "to": 4300,
   "text": "유예는 효력을 잃고요."
  },
  {
   "from_": 4312,
   "to": 4350,
   "text": "이 판결은 1심이고,"
  },
  {
   "from_": 4350,
   "to": 4421,
   "text": "항소나 확정 여부는\n보도로 확인되지 않아요."
  },
  {
   "from_": 4436,
   "to": 4446,
   "text": "자,"
  },
  {
   "from_": 4446,
   "to": 4484,
   "text": "법원의 저울을 한번 볼까요?"
  },
  {
   "from_": 4484,
   "to": 4515,
   "text": "불리한 쪽엔,"
  },
  {
   "from_": 4515,
   "to": 4571,
   "text": "고의가 분명한데 남 탓을 한 것,"
  },
  {
   "from_": 4571,
   "to": 4623,
   "text": "짧은 시간에 여러 번 그런 것,"
  },
  {
   "from_": 4623,
   "to": 4672,
   "text": "피해자가 엄벌을 원한 것."
  },
  {
   "from_": 4684,
   "to": 4713,
   "text": "유리한 쪽엔,"
  },
  {
   "from_": 4713,
   "to": 4762,
   "text": "들이받은 행동은 인정한 것,"
  },
  {
   "from_": 4762,
   "to": 4821,
   "text": "신고가 두려워 벌인 일로 보이는 것,"
  },
  {
   "from_": 4821,
   "to": 4863,
   "text": "그리고 초범이라는 것."
  },
  {
   "from_": 4878,
   "to": 4960,
   "text": "커뮤니티에선 '무서워했다니까\n봐줬다'로 퍼졌지만,"
  },
  {
   "from_": 4960,
   "to": 5027,
   "text": "그건 유리한 사정 세\n가지 중 하나였어요."
  },
  {
   "from_": 5027,
   "to": 5077,
   "text": "형법은 반성 하나가 아니라,"
  },
  {
   "from_": 5077,
   "to": 5107,
   "text": "동기와 결과,"
  },
  {
   "from_": 5107,
   "to": 5174,
   "text": "범행 후 태도까지 함께 보라고 하거든요."
  },
  {
   "from_": 5189,
   "to": 5236,
   "text": "숫자로 보면 훨씬 쉬워요."
  },
  {
   "from_": 5236,
   "to": 5304,
   "text": "법정형 최저는 1년인데 선고는 8개월."
  },
  {
   "from_": 5304,
   "to": 5350,
   "text": "감경이 들어간 걸로 볼 수 있죠."
  },
  {
   "from_": 5350,
   "to": 5395,
   "text": "그리고 3년 이하 징역이라,"
  },
  {
   "from_": 5395,
   "to": 5445,
   "text": "집행유예를 붙일 수 있었습니다."
  },
  {
   "from_": 5460,
   "to": 5509,
   "text": "그럼 이례적인 판결이었을까요?"
  },
  {
   "from_": 5509,
   "to": 5571,
   "text": "2023년 1심 특수상해 사건은,"
  },
  {
   "from_": 5571,
   "to": 5632,
   "text": "열에 일곱 이상이 집행유예였어요."
  },
  {
   "from_": 5644,
   "to": 5687,
   "text": "같은 대구지법에서,"
  },
  {
   "from_": 5687,
   "to": 5791,
   "text": "경찰에 신고한 주민이 차를 가로막자\n그대로 후진해 친 사건도,"
  },
  {
   "from_": 5791,
   "to": 5868,
   "text": "징역 8개월에 집행유예 2년이었고요."
  },
  {
   "from_": 5868,
   "to": 5912,
   "text": "다만 그 사건은 전치 2주였어요."
  },
  {
   "from_": 5933,
   "to": 6012,
   "text": "A씨는 선고 전에 300만\n원을 공탁했지만,"
  },
  {
   "from_": 6012,
   "to": 6100,
   "text": "피해자는 이걸 유리하게\n봐주는 데 반대했어요."
  },
  {
   "from_": 6100,
   "to": 6145,
   "text": "그리고 2024년,"
  },
  {
   "from_": 6145,
   "to": 6276,
   "text": "선고 직전 공탁이 있으면 법원이 피해자\n의견을 꼭 듣도록 법이 바뀌었습니다."
  },
  {
   "from_": 6291,
   "to": 6345,
   "text": "판단을 가른 건 반성 하나가 아니라,"
  },
  {
   "from_": 6345,
   "to": 6393,
   "text": "여러 사정의 무게였어요."
  },
  {
   "from_": 6393,
   "to": 6454,
   "text": "음주운전이 의심되는 차를 봤다면,"
  },
  {
   "from_": 6454,
   "to": 6498,
   "text": "112에 위치와 방향,"
  },
  {
   "from_": 6498,
   "to": 6545,
   "text": "차량 번호를 알려 주세요."
  },
  {
   "from_": 6572,
   "to": 6594,
   "text": "다음 사건도,"
  },
  {
   "from_": 6594,
   "to": 6633,
   "text": "판단의 근거부터 보겠습니다."
  }
 ],
 "audio": "ep001/mix_master.wav"
}