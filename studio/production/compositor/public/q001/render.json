 "subtitles": [
  {
   "from_": 4,
   "to": 70,
   "text": "음주운전 신고하려던\n30대 남성을,"
  },
  {
   "from_": 70,
   "to": 115,
   "text": "20대 여성 운전자가\n차로 두 번"
  },
  {
   "from_": 115,
   "to": 147,
   "text": "박았습니다."
  },
  {
   "from_": 156,
   "to": 204,
   "text": "피해자는 약 34일\n치료가 필요한"
  },
  {
   "from_": 204,
   "to": 232,
   "text": "어깨 부상."
  },
  {
   "from_": 241,
   "to": 260,
   "text": "법원도,"
  },
  {
   "from_": 260,
   "to": 315,
   "text": "진지하게 반성한다고\n볼 수 없다고 했죠."
  },
  {
   "from_": 324,
   "to": 335,
   "text": "자,"
  },
  {
   "from_": 335,
   "to": 364,
   "text": "몇 년 받았을까요?"
  },
  {
   "from_": 364,
   "to": 385,
   "text": "벌금일까요,"
  },
  {
   "from_": 385,
   "to": 411,
   "text": "집행유예일까요,"
  },
  {
   "from_": 411,
   "to": 439,
   "text": "아니면 실형일까요?"
  },
  {
   "from_": 538,
   "to": 559,
   "text": "정답은,"
  },
  {
   "from_": 559,
   "to": 606,
   "text": "징역 8개월에\n집행유예 2년."
  },
  {
   "from_": 621,
   "to": 642,
   "text": "초범이고,"
  },
  {
   "from_": 642,
   "to": 676,
   "text": "들이받은 건\n인정했고,"
  },
  {
   "from_": 676,
   "to": 724,
   "text": "신고가 두려워서\n그랬다고 봤대요."
  },
  {
   "from_": 736,
   "to": 775,
   "text": "다음 사건도\n맞혀 보세요."
  }
 ],
 "audio": "q001/mix_master.wav"
