 "subtitles": [
  {
   "from_": 4,
   "to": 65,
   "text": "술집 옆자리 손님과\n시비가 붙은 20대가"
  },
  {
   "from_": 65,
   "to": 131,
   "text": "그 손님을\n밖으로 불러냈습니다."
  },
  {
   "from_": 131,
   "to": 171,
   "text": "그리고 야차룰을\n뜨자고 했죠."
  },
  {
   "from_": 180,
   "to": 238,
   "text": "검찰은 CCTV가\n없는 곳으로 불러내"
  },
  {
   "from_": 238,
   "to": 329,
   "text": "싸움에 동의한다는 말을\n녹음하려 했다고 봤습니다."
  },
  {
   "from_": 338,
   "to": 375,
   "text": "손님은 폭행을 당해\n쓰러졌고"
  },
  {
   "from_": 375,
   "to": 409,
   "text": "끝내 숨졌습니다."
  },
  {
   "from_": 421,
   "to": 491,
   "text": "벌금, 집행유예, 실형 중\n무엇이었을까요?"
  },
  {
   "from_": 491,
   "to": 563,
   "text": "판사는 피고인이 남긴\n녹음을 들여다봤습니다."
  },
  {
   "from_": 563,
   "to": 619,
   "text": "녹음에는 더 이상\n저항할 수 없는 사람을"
  },
  {
   "from_": 619,
   "to": 677,
   "text": "계속 때린 정황이\n담겼고요."
  },
  {
   "from_": 677,
   "to": 711,
   "text": "폭행 뒤엔\n녹음 다 됐으니"
  },
  {
   "from_": 711,
   "to": 772,
   "text": "신고하려면 하라는\n말까지 있었죠."
  },
  {
   "from_": 784,
   "to": 814,
   "text": "정답은 실형."
  },
  {
   "from_": 814,
   "to": 860,
   "text": "1심은 검찰 구형\n5년보다 무거운"
  },
  {
   "from_": 860,
   "to": 908,
   "text": "징역 6년이었습니다."
  },
  {
   "from_": 908,
   "to": 947,
   "text": "2심 판결도\n그대로였습니다."
  },
  {
   "from_": 962,
   "to": 995,
   "text": "다음 사건도\n맞혀 보세요."
  }
 ],
