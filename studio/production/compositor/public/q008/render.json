 "subtitles": [
  {
   "from_": 4,
   "to": 80,
   "text": "허리가 아파\n한의원을 찾은 92세 환자가,"
  },
  {
   "from_": 80,
   "to": 116,
   "text": "가슴 부위에 침을 맞은 뒤"
  },
  {
   "from_": 116,
   "to": 159,
   "text": "같은 날 숨졌습니다."
  },
  {
   "from_": 171,
   "to": 228,
   "text": "가슴 통증과 호흡곤란을\n호소했는데도,"
  },
  {
   "from_": 228,
   "to": 273,
   "text": "약 15분간\n방치했다고 봤죠."
  },
  {
   "from_": 282,
   "to": 348,
   "text": "게다가 이 한의사,\n수사를 받던 중에"
  },
  {
   "from_": 348,
   "to": 414,
   "text": "사이가 나쁜 지인의\n카페 앞에 바윗돌을 놓아"
  },
  {
   "from_": 414,
   "to": 466,
   "text": "영업까지 방해했습니다."
  },
  {
   "from_": 475,
   "to": 485,
   "text": "자,"
  },
  {
   "from_": 485,
   "to": 513,
   "text": "몇 년 받았을까요?"
  },
  {
   "from_": 513,
   "to": 535,
   "text": "벌금일까요,"
  },
  {
   "from_": 535,
   "to": 562,
   "text": "집행유예일까요,"
  },
  {
   "from_": 562,
   "to": 591,
   "text": "아니면 실형일까요?"
  },
  {
   "from_": 690,
   "to": 706,
   "text": "정답은,"
  },
  {
   "from_": 706,
   "to": 735,
   "text": "벌금 2천만 원입니다."
  },
  {
   "from_": 750,
   "to": 797,
   "text": "범행을 인정하고\n반성했고,"
  },
  {
   "from_": 797,
   "to": 841,
   "text": "유족과\n원만히 합의했고,"
  },
  {
   "from_": 841,
   "to": 917,
   "text": "업무방해 피해자에게도\n공탁했다는 이유였어요."
  },
  {
   "from_": 929,
   "to": 963,
   "text": "다음 사건도\n맞혀 보세요."
  }
 ],
 "audio": "q008/mix_master.wav"
