 ],
 "subtitles": [
  {
   "from_": 4,
   "to": 81,
   "text": "음주운전 신고하겠다고\n차 앞을 막았더니,"
  },
  {
   "from_": 81,
   "to": 134,
   "text": "운전자가 그대로\n차로 밀어 버렸습니다."
  },
  {
   "from_": 143,
   "to": 175,
   "text": "한 번이 아니라\n여러 번."
  },
  {
   "from_": 175,
   "to": 214,
   "text": "밀려 넘어진 뒤에도,"
  },
  {
   "from_": 214,
   "to": 237,
   "text": "차를 뒤로 뺐다가"
  },
  {
   "from_": 237,
   "to": 291,
   "text": "다시 와서\n한 번 더 들이받았어요."
  },
  {
   "from_": 300,
   "to": 349,
   "text": "피해자는 약 34일\n치료가 필요한"
  },
  {
   "from_": 349,
   "to": 398,
   "text": "어깨 부상을\n입었습니다."
  },
  {
   "from_": 407,
   "to": 459,
   "text": "그런데 운전자 측\n주장은 이랬어요."
  },
  {
   "from_": 459,
   "to": 495,
   "text": "부주의한\n운전 탓이다,"
  },
  {
   "from_": 495,
   "to": 531,
   "text": "저 사람이\n뛰어든 거다."
  },
  {
   "from_": 540,
   "to": 602,
   "text": "하지만 현장 CCTV에\n다 찍혀 있었고,"
  },
  {
   "from_": 602,
   "to": 650,
   "text": "법원은\n고의라고 봤어요."
  },
  {
   "from_": 650,
   "to": 687,
   "text": "진지한 반성도\n없다고 했죠."
  },
  {
   "from_": 699,
   "to": 735,
   "text": "자, 여러분이\n판사라면?"
  },
  {
   "from_": 735,
   "to": 775,
   "text": "실형일까요,\n집행유예일까요?"
  },
  {
   "from_": 814,
   "to": 834,
   "text": "판결은,"
  },
  {
   "from_": 834,
   "to": 881,
   "text": "징역 8개월에\n집행유예 2년."
  },
  {
   "from_": 908,
   "to": 966,
   "text": "반성은 없었지만,\n초범이었고,"
  },
  {
   "from_": 966,
   "to": 1004,
   "text": "들이받은 건\n인정했고,"
  },
  {
   "from_": 1004,
   "to": 1056,
   "text": "신고가 두려워\n그랬다고 본 거예요."
  },
  {
   "from_": 1071,
   "to": 1119,
   "text": "이 판결,\n여러분 생각은 어때요?"
  }
 ],
 "audio": "s001/mix_master.wav"
