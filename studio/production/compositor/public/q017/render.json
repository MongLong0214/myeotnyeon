 "subtitles": [
  {
   "from_": 4,
   "to": 49,
   "text": "아파트에서 이웃을\n일본도로 살해한"
  },
  {
   "from_": 49,
   "to": 76,
   "text": "사건입니다."
  },
  {
   "from_": 85,
   "to": 122,
   "text": "피고인은 심신미약을 이유로"
  },
  {
   "from_": 122,
   "to": 168,
   "text": "형을 줄여 달라고\n주장했죠."
  },
  {
   "from_": 177,
   "to": 197,
   "text": "반대로 검찰은"
  },
  {
   "from_": 197,
   "to": 264,
   "text": "1심과 2심 모두\n사형을 구형했습니다."
  },
  {
   "from_": 273,
   "to": 338,
   "text": "벌금, 집행유예, 실형 중\n무엇이었을까요?"
  },
  {
   "from_": 338,
   "to": 387,
   "text": "2심은 심신미약을\n인정했죠."
  },
  {
   "from_": 387,
   "to": 444,
   "text": "그래도 형을 줄일\n사유는 아니라고 봤죠."
  },
  {
   "from_": 444,
   "to": 466,
   "text": "범행이 중대하고"
  },
  {
   "from_": 466,
   "to": 523,
   "text": "재범 위험도 있다고\n판단했습니다."
  },
  {
   "from_": 574,
   "to": 602,
   "text": "정답은 실형."
  },
  {
   "from_": 602,
   "to": 653,
   "text": "1심과 2심 모두\n무기징역."
  },
  {
   "from_": 653,
   "to": 699,
   "text": "대법원에서\n그대로 확정됐습니다."
  },
  {
   "from_": 708,
   "to": 745,
   "text": "다음 사건도\n맞혀 보세요."
  }
 ],
