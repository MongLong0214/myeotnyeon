 "subtitles": [
  {
   "from_": 0,
   "to": 61,
   "text": "27명이 숨진\n지난해 경북 산불은"
  },
  {
   "from_": 61,
   "to": 108,
   "text": "두 곳에서 시작됐습니다."
  },
  {
   "from_": 108,
   "to": 140,
   "text": "몇 년 나왔을까?"
  },
  {
   "from_": 145,
   "to": 207,
   "text": "그중 한 곳이\n의성군에 있는 과수원이었죠."
  },
  {
   "from_": 216,
   "to": 291,
   "text": "60대 과수원 임차인이\n농사 부산물을 태운 뒤"
  },
  {
   "from_": 291,
   "to": 342,
   "text": "불씨가 꺼졌는지\n확인하지 않고"
  },
  {
   "from_": 342,
   "to": 401,
   "text": "자리를 떠난 혐의였습니다."
  },
  {
   "from_": 410,
   "to": 481,
   "text": "불은 강풍을 타고\n5개 시·군까지 번졌죠."
  },
  {
   "from_": 490,
   "to": 543,
   "text": "149시간 동안\n27명이 숨지고"
  },
  {
   "from_": 543,
   "to": 593,
   "text": "40명이 다쳤습니다."
  },
  {
   "from_": 605,
   "to": 678,
   "text": "벌금, 집행유예, 실형 중\n무엇이었을까요?"
  },
  {
   "from_": 678,
   "to": 760,
   "text": "2심 재판부는 결과가\n상당히 무겁다고 봤습니다."
  },
  {
   "from_": 760,
   "to": 817,
   "text": "죄명은 실수로\n불을 낸 실화였고요."
  },
  {
   "from_": 817,
   "to": 890,
   "text": "2심에서 검찰 구형은\n징역 3년이었습니다."
  },
  {
   "from_": 899,
   "to": 934,
   "text": "1심은\n징역 2년 6개월에"
  },
  {
   "from_": 934,
   "to": 970,
   "text": "집행유예 3년."
  },
  {
   "from_": 970,
   "to": 1010,
   "text": "2심 판결도\n그대로였습니다."
  },
  {
   "from_": 1025,
   "to": 1061,
   "text": "다음 사건도\n맞혀 보세요."
  }
 ],
 "audio": "q012/v5/mix_master_r2.wav"
