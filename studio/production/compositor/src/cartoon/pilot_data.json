art":1290,"end":1350,"view":"midnight","character":true,"motion":true,"facts":["F07","F08"]}],"subtitles":[{"from":0,"to":67,"text":"검은 승용차가 현금수송차 앞을 막습니다.","narration_id":"N001"},{"from":72,"to":162,"text":"돈가방을 내리던 순간 복면을 쓴 두 사람이 나타났죠.","narration_id":"N001"},{"from":162,"to":234,"text":"은행 지하주차장에서 권총이 발사됩니다.","narration_id":"N001"},{"from":240,"to":324,"text":"법원은 두 사람 모두에게 무기징역을 선고했습니다.","narration_id":"N002"},{"from":327,"to":392,"text":"총을 쏜 사람과 돈가방을 옮긴 사람.","narration_id":"N002"},{"from":393,"to":446,"text":"두 사람은 왜 같은 형이 됐을까요?","narration_id":"N002"},{"from":450,"to":522,"text":"이천일 년 십이월 이십일 일 오전 열 시쯤.","narration_id":"N003"},{"from":524,"to":616,"text":"대전 둔산동 국민은행 건물 지하주차장으로 돌아갑니다.","narration_id":"N003"},{"from":620,"to":707,"text":"은행 관계자 세 명이 현금을 내려 옮기던 순간이었죠.","narration_id":"N004"},{"from":707,"to":786,"text":"돈가방은 두 개. 각각 삼억 원씩 들어 있었습니다.","narration_id":"N004"},{"from":794,"to":864,"text":"강도들이 가져간 것은 그중 한 가방이었어요.","narration_id":"N005"},{"from":864,"to":969,"text":"피해액 삼억 원. 현금을 운송하던\n사십 대 은행 출납과장은","narration_id":"N005"},{"from":969,"to":1006,"text":"총격으로 숨졌습니다.","narration_id":"N005"},{"from":1010,"to":1074,"text":"주차장에는 폐쇄회로 카메라가 없었죠.","narration_id":"N006"},{"from":1075,"to":1184,"text":"범행 뒤 두 사람은 인근 상가\n지하주차장에서 차를 버리고 다른","narration_id":"N006"},{"from":1184,"to":1212,"text":"차로 갈아탑니다.","narration_id":"N006"},{"from":1217,"to":1318,"text":"그들이 쓴 권총의 출처를 따라가면\n두 달 전 범행이 나와요.","narration_id":"N007"},{"from":1320,"to":1350,"text":"십월 십오 일 자정 무렵","narration_id":"N007"}],"envelope":[0.2104,1.0,1.0,0.6639,1.0,1.0,0.7462,0.2837,0.2894,0.3288,0.6631,1.0,1.0,0.71,0.4669,0.0058,0.2892,0.2588,1.0,0.2974,0.664,1.0,0.9679,0.814,0.6533,0.2048,0.0609,0.1085,1.0,0.7065,0.6319,0.3707,0.6712,1.0,0.5948,0.5402,0.1935,0.1746,0.197,0.2357,0.1349,1.0,0.7946,0.4456,0.1243,0.194,0.9992,0.9062,0.8103,0.02,0.0,0.0497,0.9155,0.5237,0.4468,0.8917,0.4227,0.0,0.0479,0.095,0.0807,0.3101,0.4273,0.5004,0.4187,0.0304,0.3516,0.247,0.0676,0.0135,0.0003,0.0,0.0,0.0146,0.7666,1.0,