  "subtitles": [
    {
      "from_": 0,
      "to": 63,
      "text": "술집 옆자리 손님과\n시비가 붙은 20대가"
    },
    {
      "from_": 63,
      "to": 101,
      "text": "그 손님을\n밖으로 불러냈습니다."
    },
    {
      "from_": 101,
      "to": 127,
      "text": "몇 년 나왔을까?"
    },
    {
      "from_": 130,
      "to": 167,
      "text": "그리고 야차룰을\n뜨자고 했죠."
    },
    {
      "from_": 167,
      "to": 233,
      "text": "검찰은 CCTV가\n없는 곳으로 불러내"
    },
    {
      "from_": 233,
      "to": 314,
      "text": "싸움에 동의한다는 말을\n녹음하려 했다고 봤습니다."
    },
    {
      "from_": 314,
      "to": 362,
      "text": "손님은 폭행을 당해\n쓰러졌고"
    },
    {
      "from_": 362,
      "to": 387,
      "text": "끝내 숨졌습니다."
    },
    {
      "from_": 387,
      "to": 452,
      "text": "벌금, 집행유예, 실형 중\n무엇이었을까요?"
    },
    {
      "from_": 455,
      "to": 520,
      "text": "판사는 피고인이 남긴\n녹음을 들여다봤습니다."
    },
    {
      "from_": 520,
      "to": 583,
      "text": "녹음에는 더 이상\n저항할 수 없는 사람을"
    },
    {
      "from_": 583,
      "to": 628,
      "text": "계속 때린 정황이\n담겼고요."
    },
    {
      "from_": 628,
      "to": 673,
      "text": "폭행 뒤엔\n녹음 다 됐으니"
    },
    {
      "from_": 673,
      "to": 723,
      "text": "신고하려면 하라는\n말까지 있었죠."
    },
    {
      "from_": 723,
      "to": 751,
      "text": "정답은 실형."
    },
    {
      "from_": 751,
      "to": 810,
      "text": "1심은 검찰 구형\n5년보다 무거운"
    },
    {
      "from_": 810,
      "to": 842,
      "text": "징역 6년이었습니다."
    },
    {
      "from_": 842,
      "to": 877,
      "text": "2심 판결도\n그대로였습니다."
    },
    {
      "from_": 883,
      "to": 914,
      "text": "다음 사건도\n맞혀 보세요."
    }
  ],
