  "subtitles": [
    {
      "from_": 0,
      "to": 55,
      "text": "약 1만 1천 미터\n상공을 날던 여객기에서"
    },
    {
      "from_": 55,
      "to": 94,
      "text": "한 승객이\n비상문 레버를"
    },
    {
      "from_": 94,
      "to": 114,
      "text": "들어 올렸습니다."
    },
    {
      "from_": 118,
      "to": 143,
      "text": "몇 년 받았을까?"
    },
    {
      "from_": 146,
      "to": 193,
      "text": "방콕에서 대구로\n오던 비행기였고"
    },
    {
      "from_": 193,
      "to": 249,
      "text": "홍콩과 대만 사이를\n지나던 중이었죠."
    },
    {
      "from_": 252,
      "to": 287,
      "text": "실제로 문은\n열리지 않았습니다."
    },
    {
      "from_": 291,
      "to": 344,
      "text": "이 승객은\n항공보안법 위반 혐의로"
    },
    {
      "from_": 344,
      "to": 371,
      "text": "재판에 넘겨졌어요."
    },
    {
      "from_": 373,
      "to": 427,
      "text": "벌금, 집행유예, 실형 중\n무엇이었을까요?"
    },
    {
      "from_": 430,
      "to": 487,
      "text": "판사는 먼저 죄책이\n가볍지 않다고 했습니다."
    },
    {
      "from_": 494,
      "to": 541,
      "text": "다만 실제로 문이 열릴 가능성은"
    },
    {
      "from_": 541,
      "to": 570,
      "text": "거의 없었다고 봤고요."
    },
    {
      "from_": 574,
      "to": 607,
      "text": "레버도 한 번 올렸을 뿐"
    },
    {
      "from_": 607,
      "to": 638,
      "text": "계속 열려고 하진 않았죠."
    },
    {
      "from_": 640,
      "to": 698,
      "text": "정답은 징역 4개월에\n집행유예 2년입니다."
    },
    {
      "from_": 703,
      "to": 751,
      "text": "사회봉사 80시간도\n함께 명령했어요."
    },
    {
      "from_": 751,
      "to": 785,
      "text": "다음 사건도\n맞혀 보세요."
    }
  ],
