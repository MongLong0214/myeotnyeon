 "subtitles": [
  {
   "from_": 0,
   "to": 58,
   "text": "배달 음식 받는 곳을\n바꿨다는 이유로"
  },
  {
   "from_": 58,
   "to": 120,
   "text": "외국인 노동자에게\n박치기를 22번 했습니다."
  },
  {
   "from_": 126,
   "to": 152,
   "text": "몇 년 받았을까?"
  },
  {
   "from_": 155,
   "to": 209,
   "text": "노동자는 뇌진탕 등\n상해를 입었고"
  },
  {
   "from_": 209,
   "to": 266,
   "text": "관리자는 구속된 채\n재판에 넘겨졌죠."
  },
  {
   "from_": 270,
   "to": 299,
   "text": "게다가 음주운전으로"
  },
  {
   "from_": 299,
   "to": 341,
   "text": "집행유예 기간 중이었어요."
  },
  {
   "from_": 345,
   "to": 409,
   "text": "벌금, 집행유예, 실형 중\n무엇이었을까요?"
  },
  {
   "from_": 413,
   "to": 448,
   "text": "판사는 집행유예 기간에"
  },
  {
   "from_": 448,
   "to": 491,
   "text": "자숙하지 않았다고\n꼬집었습니다."
  },
  {
   "from_": 499,
   "to": 538,
   "text": "다만 범행을 모두 인정했고"
  },
  {
   "from_": 538,
   "to": 597,
   "text": "구금 생활로\n반성했을 거라고 봤어요."
  },
  {
   "from_": 602,
   "to": 629,
   "text": "700만 원에 합의해"
  },
  {
   "from_": 629,
   "to": 676,
   "text": "피해자도 처벌을\n원치 않았죠."
  },
  {
   "from_": 680,
   "to": 719,
   "text": "정답은\n벌금 400만 원입니다."
  },
  {
   "from_": 722,
   "to": 765,
   "text": "검찰은 징역 1년을\n구형했었죠."
  },
  {
   "from_": 766,
   "to": 796,
   "text": "다음 사건도\n맞혀 보세요."
  }
 ],
