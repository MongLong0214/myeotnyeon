 "subtitles": [
  {
   "from_": 0,
   "to": 65,
   "text": "아파트에서 이웃을\n일본도로 살해한"
  },
  {
   "from_": 65,
   "to": 86,
   "text": "사건입니다."
  },
  {
   "from_": 90,
   "to": 126,
   "text": "어떤 형이 나왔을까?"
  },
  {
   "from_": 130,
   "to": 184,
   "text": "피고인은 심신미약을 이유로"
  },
  {
   "from_": 184,
   "to": 233,
   "text": "형을 줄여 달라고\n주장했죠."
  },
  {
   "from_": 237,
   "to": 261,
   "text": "반대로 검찰은"
  },
  {
   "from_": 261,
   "to": 329,
   "text": "1심과 2심 모두\n사형을 구형했습니다."
  },
  {
   "from_": 339,
   "to": 410,
   "text": "벌금, 집행유예, 실형 중\n무엇이었을까요?"
  },
  {
   "from_": 415,
   "to": 466,
   "text": "2심은 심신미약을\n인정했죠."
  },
  {
   "from_": 472,
   "to": 540,
   "text": "그래도 형을 줄일\n사유는 아니라고 봤죠."
  },
  {
   "from_": 545,
   "to": 577,
   "text": "범행이 중대하고"
  },
  {
   "from_": 577,
   "to": 635,
   "text": "재범 위험도 있다고\n판단했습니다."
  },
  {
   "from_": 643,
   "to": 666,
   "text": "정답은 실형."
  },
  {
   "from_": 670,
   "to": 718,
   "text": "1심과 2심 모두\n무기징역."
  },
  {
   "from_": 720,
   "to": 779,
   "text": "대법원에서\n그대로 확정됐습니다."
  },
  {
   "from_": 784,
   "to": 825,
   "text": "다음 사건도\n맞혀 보세요."
  }
 ],
