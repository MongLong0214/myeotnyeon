 "subtitles": [
  {
   "from_": 0,
   "to": 52,
   "text": "아파트에서 이웃을\n일본도로 살해한"
  },
  {
   "from_": 52,
   "to": 67,
   "text": "사건입니다."
  },
  {
   "from_": 69,
   "to": 98,
   "text": "어떤 형이 나왔을까?"
  },
  {
   "from_": 101,
   "to": 145,
   "text": "피고인은 심신미약을 이유로"
  },
  {
   "from_": 145,
   "to": 181,
   "text": "형을 줄여 달라고\n주장했죠."
  },
  {
   "from_": 185,
   "to": 208,
   "text": "반대로 검찰은"
  },
  {
   "from_": 208,
   "to": 263,
   "text": "1심과 2심 모두\n사형을 구형했습니다."
  },
  {
   "from_": 272,
   "to": 329,
   "text": "벌금, 집행유예, 실형 중\n무엇이었을까요?"
  },
  {
   "from_": 332,
   "to": 374,
   "text": "2심은 심신미약을\n인정했죠."
  },
  {
   "from_": 378,
   "to": 425,
   "text": "그래도 형을 줄일\n사유는 아니라고 봤죠."
  },
  {
   "from_": 428,
   "to": 452,
   "text": "범행이 중대하고"
  },
  {
   "from_": 452,
   "to": 500,
   "text": "재범 위험도 있다고\n판단했습니다."
  },
  {
   "from_": 507,
   "to": 529,
   "text": "정답은 실형."
  },
  {
   "from_": 531,
   "to": 579,
   "text": "1심과 2심 모두\n무기징역."
  },
  {
   "from_": 581,
   "to": 622,
   "text": "대법원에서\n그대로 확정됐습니다."
  },
  {
   "from_": 626,
   "to": 659,
   "text": "다음 사건도\n맞혀 보세요."
  }
 ],
