 "subtitles": [
  {
   "from_": 4,
   "to": 52,
   "text": "음주단속을 피하려고,"
  },
  {
   "from_": 52,
   "to": 85,
   "text": "경찰관을 차에\n매단 채"
  },
  {
   "from_": 85,
   "to": 144,
   "text": "약 131미터를\n달렸습니다."
  },
  {
   "from_": 153,
   "to": 201,
   "text": "경찰관은 주차된\n차에 부딪혀,"
  },
  {
   "from_": 201,
   "to": 234,
   "text": "8주를 다쳤어요."
  },
  {
   "from_": 243,
   "to": 253,
   "text": "자,"
  },
  {
   "from_": 253,
   "to": 280,
   "text": "몇 년 받았을까요?"
  },
  {
   "from_": 280,
   "to": 301,
   "text": "벌금일까요,"
  },
  {
   "from_": 301,
   "to": 326,
   "text": "집행유예일까요,"
  },
  {
   "from_": 326,
   "to": 353,
   "text": "아니면 실형일까요?"
  },
  {
   "from_": 452,
   "to": 471,
   "text": "정답은,"
  },
  {
   "from_": 471,
   "to": 513,
   "text": "징역 2년에\n집행유예 3년."
  },
  {
   "from_": 528,
   "to": 544,
   "text": "대신,"
  },
  {
   "from_": 544,
   "to": 571,
   "text": "이 사람이\n몰던 외제차는"
  },
  {
   "from_": 571,
   "to": 597,
   "text": "몰수됐습니다."
  },
  {
   "from_": 609,
   "to": 648,
   "text": "다음 사건도\n맞혀 보세요."
  }
 ],
