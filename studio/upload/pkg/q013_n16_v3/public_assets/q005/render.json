 "subtitles": [
  {
   "from_": 4,
   "to": 70,
   "text": "벽돌공장의\n50대 지게차 기사가,"
  },
  {
   "from_": 70,
   "to": 103,
   "text": "스리랑카 출신 동료를"
  },
  {
   "from_": 103,
   "to": 129,
   "text": "벽돌 더미에 묶어"
  },
  {
   "from_": 129,
   "to": 183,
   "text": "지게차로\n들어 올렸습니다."
  },
  {
   "from_": 192,
   "to": 231,
   "text": "약 10미터를\n끌고 다녔고,"
  },
  {
   "from_": 231,
   "to": 275,
   "text": "이유는 일이\n서툴다는 거였어요."
  },
  {
   "from_": 284,
   "to": 319,
   "text": "영상이 공개되자,"
  },
  {
   "from_": 319,
   "to": 367,
   "text": "대통령까지 명백한\n인권 유린이라며"
  },
  {
   "from_": 367,
   "to": 393,
   "text": "분노했죠."
  },
  {
   "from_": 402,
   "to": 412,
   "text": "자,"
  },
  {
   "from_": 412,
   "to": 439,
   "text": "몇 년 받았을까요?"
  },
  {
   "from_": 439,
   "to": 461,
   "text": "벌금일까요,"
  },
  {
   "from_": 461,
   "to": 487,
   "text": "집행유예일까요,"
  },
  {
   "from_": 487,
   "to": 516,
   "text": "아니면 실형일까요?"
  },
  {
   "from_": 615,
   "to": 633,
   "text": "정답은,"
  },
  {
   "from_": 633,
   "to": 673,
   "text": "징역 1년에\n집행유예 2년."
  },
  {
   "from_": 688,
   "to": 732,
   "text": "피해자가 처벌을\n원하지 않았고,"
  },
  {
   "from_": 732,
   "to": 769,
   "text": "합의했다는\n이유였어요."
  },
  {
   "from_": 781,
   "to": 827,
   "text": "노동단체는 솜방망이\n처벌이라며"
  },
  {
   "from_": 827,
   "to": 860,
   "text": "반발했습니다."
  },
  {
   "from_": 872,
   "to": 907,
   "text": "다음 사건도\n맞혀 보세요."
  }
 ],
 "audio": "q005/mix_master.wav"
