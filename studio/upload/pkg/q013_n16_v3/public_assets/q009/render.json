 "subtitles": [
  {
   "from_": 4,
   "to": 76,
   "text": "강아지 친구를\n만들어 주고 싶다며,"
  },
  {
   "from_": 76,
   "to": 116,
   "text": "20대 남성이 넉 달 동안"
  },
  {
   "from_": 116,
   "to": 164,
   "text": "개 5마리와\n고양이 6마리를"
  },
  {
   "from_": 164,
   "to": 245,
   "text": "입양하거나\n임시 보호로 데려왔습니다."
  },
  {
   "from_": 254,
   "to": 311,
   "text": "그리고 스트레스를\n푼다는 이유로,"
  },
  {
   "from_": 311,
   "to": 374,
   "text": "단기간에\n11마리를 모두 죽였습니다."
  },
  {
   "from_": 389,
   "to": 420,
   "text": "수사를 받는 중에도,"
  },
  {
   "from_": 420,
   "to": 457,
   "text": "고양이를 또\n데려왔고요."
  },
  {
   "from_": 466,
   "to": 476,
   "text": "자,"
  },
  {
   "from_": 476,
   "to": 504,
   "text": "몇 년 받았을까요?"
  },
  {
   "from_": 504,
   "to": 525,
   "text": "벌금일까요,"
  },
  {
   "from_": 525,
   "to": 550,
   "text": "집행유예일까요,"
  },
  {
   "from_": 550,
   "to": 577,
   "text": "아니면 실형일까요?"
  },
  {
   "from_": 676,
   "to": 719,
   "text": "1심은\n집행유예였는데,"
  },
  {
   "from_": 719,
   "to": 762,
   "text": "2심은 징역\n1년 6개월."
  },
  {
   "from_": 762,
   "to": 815,
   "text": "실형, 법정구속입니다."
  },
  {
   "from_": 830,
   "to": 867,
   "text": "수법이 매우 잔혹하고,"
  },
  {
   "from_": 867,
   "to": 927,
   "text": "진정으로 뉘우치는\n모습이 없다고 봤어요."
  },
  {
   "from_": 939,
   "to": 982,
   "text": "법정구속되는 순간에도,"
  },
  {
   "from_": 982,
   "to": 1028,
   "text": "여자친구가 있어\n잡혀가면 안 된다고"
  },
  {
   "from_": 1028,
   "to": 1071,
   "text": "말했다고 전해졌습니다."
  },
  {
   "from_": 1083,
   "to": 1120,
   "text": "다음 사건도\n맞혀 보세요."
  }
 ],
 "audio": "q009/mix_master.wav"
