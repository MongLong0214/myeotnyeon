 "subtitles": [
  {
   "from_": 4,
   "to": 70,
   "text": "아이를 학대했다고\n의심한 학부모가,"
  },
  {
   "from_": 70,
   "to": 105,
   "text": "어린이집 교사의\n얼굴을"
  },
  {
   "from_": 105,
   "to": 161,
   "text": "똥 묻은 기저귀로\n때렸습니다."
  },
  {
   "from_": 170,
   "to": 217,
   "text": "교사는 안경이\n부러졌고,"
  },
  {
   "from_": 217,
   "to": 257,
   "text": "판결 때까지도\n일을 못 할 만큼"
  },
  {
   "from_": 257,
   "to": 298,
   "text": "고통을 호소했대요."
  },
  {
   "from_": 307,
   "to": 354,
   "text": "학부모가 낸\n아동학대 고소는,"
  },
  {
   "from_": 354,
   "to": 389,
   "text": "전부 불기소였고요."
  },
  {
   "from_": 398,
   "to": 408,
   "text": "자,"
  },
  {
   "from_": 408,
   "to": 434,
   "text": "몇 년 받았을까요?"
  },
  {
   "from_": 434,
   "to": 454,
   "text": "벌금일까요,"
  },
  {
   "from_": 454,
   "to": 478,
   "text": "집행유예일까요,"
  },
  {
   "from_": 478,
   "to": 504,
   "text": "아니면 실형일까요?"
  },
  {
   "from_": 603,
   "to": 643,
   "text": "1심은\n집행유예였는데,"
  },
  {
   "from_": 643,
   "to": 702,
   "text": "2심은 징역 6개월.\n실형입니다."
  },
  {
   "from_": 717,
   "to": 780,
   "text": "얼굴에 오물을 묻힌 건\n모욕할 의도였고,"
  },
  {
   "from_": 780,
   "to": 818,
   "text": "피해 회복도\n안 됐고,"
  },
  {
   "from_": 818,
   "to": 862,
   "text": "반성도 없었다고\n봤어요."
  },
  {
   "from_": 874,
   "to": 916,
   "text": "다음 사건도\n맞혀 보세요."
  }
 ],
