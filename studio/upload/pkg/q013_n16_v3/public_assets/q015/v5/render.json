 "subtitles": [
  {
   "from_": 0,
   "to": 36,
   "text": "규정을 어긴 얼차려로"
  },
  {
   "from_": 36,
   "to": 81,
   "text": "훈련병이 숨진 사건입니다."
  },
  {
   "from_": 81,
   "to": 110,
   "text": "몇 년 받았을까?"
  },
  {
   "from_": 119,
   "to": 160,
   "text": "중대장은 훈련병 6명에게"
  },
  {
   "from_": 160,
   "to": 237,
   "text": "규정을 어긴 군기훈련을\n지시한 혐의였죠."
  },
  {
   "from_": 246,
   "to": 266,
   "text": "재판의 쟁점은"
  },
  {
   "from_": 266,
   "to": 336,
   "text": "하나의 행위인지\n여러 행위인지였습니다."
  },
  {
   "from_": 345,
   "to": 411,
   "text": "벌금, 집행유예, 실형 중\n무엇이었을까요?"
  },
  {
   "from_": 411,
   "to": 464,
   "text": "1심은 하나의 행위로\n봤습니다."
  },
  {
   "from_": 464,
   "to": 489,
   "text": "2심은 피해자마다"
  },
  {
   "from_": 489,
   "to": 546,
   "text": "학대 양상이 달랐다고\n판단했죠."
  },
  {
   "from_": 546,
   "to": 589,
   "text": "그래서 여러 행위로\n다시 봤습니다."
  },
  {
   "from_": 637,
   "to": 655,
   "text": "실형."
  },
  {
   "from_": 655,
   "to": 702,
   "text": "중대장은 1심 징역 5년."
  },
  {
   "from_": 702,
   "to": 738,
   "text": "2심은 5년 6개월로 늘었고"
  },
  {
   "from_": 738,
   "to": 778,
   "text": "그대로 확정됐습니다."
  },
  {
   "from_": 787,
   "to": 821,
   "text": "다음 사건도\n맞혀 보세요."
  }
 ],
