 "subtitles": [
  {
   "from_": 4,
   "to": 64,
   "text": "약 1만 1천 미터\n상공을 날던 여객기에서"
  },
  {
   "from_": 64,
   "to": 99,
   "text": "한 승객이\n비상문 레버를"
  },
  {
   "from_": 99,
   "to": 138,
   "text": "들어 올렸습니다."
  },
  {
   "from_": 147,
   "to": 193,
   "text": "방콕에서 대구로\n오던 비행기였고"
  },
  {
   "from_": 193,
   "to": 255,
   "text": "홍콩과 대만 사이를\n지나던 중이었죠."
  },
  {
   "from_": 264,
   "to": 311,
   "text": "실제로 문은\n열리지 않았습니다."
  },
  {
   "from_": 311,
   "to": 358,
   "text": "이 승객은\n항공보안법 위반 혐의로"
  },
  {
   "from_": 358,
   "to": 399,
   "text": "재판에 넘겨졌어요."
  },
  {
   "from_": 408,
   "to": 475,
   "text": "벌금, 집행유예, 실형 중\n무엇이었을까요?"
  },
  {
   "from_": 475,
   "to": 542,
   "text": "판사는 먼저 죄책이\n가볍지 않다고 했습니다."
  },
  {
   "from_": 542,
   "to": 584,
   "text": "다만 실제로 문이 열릴 가능성은"
  },
  {
   "from_": 584,
   "to": 632,
   "text": "거의 없었다고 봤고요."
  },
  {
   "from_": 632,
   "to": 662,
   "text": "레버도 한 번 올렸을 뿐"
  },
  {
   "from_": 662,
   "to": 708,
   "text": "계속 열려고 하진 않았죠."
  },
  {
   "from_": 720,
   "to": 800,
   "text": "정답은 징역 4개월에\n집행유예 2년입니다."
  },
  {
   "from_": 800,
   "to": 861,
   "text": "사회봉사 80시간도\n함께 명령했어요."
  },
  {
   "from_": 876,
   "to": 909,
   "text": "다음 사건도\n맞혀 보세요."
  }
 ],
 "audio": "q011/mix_master.wav"
