 "subtitles": [
  {
   "from_": 4,
   "to": 52,
   "text": "수원 일대 주택\n800여 가구를"
  },
  {
   "from_": 52,
   "to": 92,
   "text": "사들인 일가족이,"
  },
  {
   "from_": 92,
   "to": 143,
   "text": "세입자 500여 명의\n전세보증금"
  },
  {
   "from_": 143,
   "to": 202,
   "text": "760억 원을\n가로챘습니다."
  },
  {
   "from_": 211,
   "to": 271,
   "text": "그런데 이 일가족,\n게임 아이템에만"
  },
  {
   "from_": 271,
   "to": 342,
   "text": "최소 13억 원을\n썼다고 법원은 지적했죠."
  },
  {
   "from_": 351,
   "to": 362,
   "text": "자,"
  },
  {
   "from_": 362,
   "to": 392,
   "text": "몇 년 받았을까요?"
  },
  {
   "from_": 392,
   "to": 412,
   "text": "벌금일까요,"
  },
  {
   "from_": 412,
   "to": 437,
   "text": "집행유예일까요,"
  },
  {
   "from_": 437,
   "to": 464,
   "text": "아니면 실형일까요?"
  },
  {
   "from_": 563,
   "to": 582,
   "text": "정답은,"
  },
  {
   "from_": 582,
   "to": 607,
   "text": "징역 15년."
  },
  {
   "from_": 607,
   "to": 653,
   "text": "법으로 줄 수 있는\n최고형입니다."
  },
  {
   "from_": 668,
   "to": 725,
   "text": "보증금은 서민에게\n전 재산과 같고,"
  },
  {
   "from_": 725,
   "to": 766,
   "text": "피해자가\n500명이 넘는다는"
  },
  {
   "from_": 766,
   "to": 795,
   "text": "이유였어요."
  },
  {
   "from_": 807,
   "to": 844,
   "text": "아내는 징역 6년,"
  },
  {
   "from_": 844,
   "to": 898,
   "text": "감정평가사 아들은\n징역 4년."
  },
  {
   "from_": 898,
   "to": 958,
   "text": "대법원에서\n그대로 확정됐습니다."
  },
  {
   "from_": 970,
   "to": 1008,
   "text": "다음 사건도\n맞혀 보세요."
  }
 ],
