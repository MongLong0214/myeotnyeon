 "subtitles": [
  {
   "from_": 4,
   "to": 47,
   "text": "층간소음 때문이라며,"
  },
  {
   "from_": 47,
   "to": 99,
   "text": "20대 남성이 아파트\n엘리베이터에서"
  },
  {
   "from_": 99,
   "to": 158,
   "text": "윗집 50대 이웃을\n살해했습니다."
  },
  {
   "from_": 170,
   "to": 254,
   "text": "이 남성은 방음부스에\n1,270만 원을 들였는데도"
  },
  {
   "from_": 254,
   "to": 307,
   "text": "소음이 계속됐다고\n주장했죠."
  },
  {
   "from_": 316,
   "to": 347,
   "text": "하지만 법원은,"
  },
  {
   "from_": 347,
   "to": 387,
   "text": "그 소음이 모두\n윗집에서 났다고"
  },
  {
   "from_": 387,
   "to": 436,
   "text": "단정하기 어렵다고\n봤습니다."
  },
  {
   "from_": 448,
   "to": 458,
   "text": "자,"
  },
  {
   "from_": 458,
   "to": 485,
   "text": "몇 년 받았을까요?"
  },
  {
   "from_": 485,
   "to": 511,
   "text": "15년일까요,"
  },
  {
   "from_": 511,
   "to": 537,
   "text": "20년일까요,"
  },
  {
   "from_": 537,
   "to": 570,
   "text": "아니면 25년일까요?"
  },
  {
   "from_": 669,
   "to": 719,
   "text": "정답은, 징역 25년."
  },
  {
   "from_": 719,
   "to": 778,
   "text": "검찰 구형 20년보다\n무거웠습니다."
  },
  {
   "from_": 793,
   "to": 881,
   "text": "배심원 7명 중 5명은\n징역 30년 의견이었고,"
  },
  {
   "from_": 881,
   "to": 962,
   "text": "반성하지 않는 태도가\n가중 사유가 됐어요."
  },
  {
   "from_": 974,
   "to": 1007,
   "text": "피해자의 딸은,"
  },
  {
   "from_": 1007,
   "to": 1059,
   "text": "평소 슬리퍼를 신고\n소음방지 매트까지"
  },
  {
   "from_": 1059,
   "to": 1101,
   "text": "깔았다고 말했습니다."
  },
  {
   "from_": 1116,
   "to": 1151,
   "text": "다음 사건도\n맞혀 보세요."
  }
 ],
 "audio": "q010/mix_master.wav"
