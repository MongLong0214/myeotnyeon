 "subtitles": [
  {
   "from_": 0,
   "to": 31,
   "text": "규정을 어긴 얼차려로"
  },
  {
   "from_": 31,
   "to": 66,
   "text": "훈련병이 숨진 사건입니다."
  },
  {
   "from_": 67,
   "to": 87,
   "text": "몇 년 받았을까?"
  },
  {
   "from_": 90,
   "to": 136,
   "text": "중대장은 훈련병 6명에게"
  },
  {
   "from_": 136,
   "to": 205,
   "text": "규정을 어긴 군기훈련을\n지시한 혐의였죠."
  },
  {
   "from_": 208,
   "to": 233,
   "text": "재판의 쟁점은"
  },
  {
   "from_": 233,
   "to": 288,
   "text": "하나의 행위인지\n여러 행위인지였습니다."
  },
  {
   "from_": 298,
   "to": 355,
   "text": "벌금, 집행유예, 실형 중\n무엇이었을까요?"
  },
  {
   "from_": 359,
   "to": 401,
   "text": "1심은 하나의 행위로\n봤습니다."
  },
  {
   "from_": 408,
   "to": 434,
   "text": "2심은 피해자마다"
  },
  {
   "from_": 434,
   "to": 481,
   "text": "학대 양상이 달랐다고\n판단했죠."
  },
  {
   "from_": 486,
   "to": 525,
   "text": "그래서 여러 행위로\n다시 봤습니다."
  },
  {
   "from_": 530,
   "to": 539,
   "text": "실형."
  },
  {
   "from_": 541,
   "to": 584,
   "text": "중대장은 1심 징역 5년."
  },
  {
   "from_": 586,
   "to": 631,
   "text": "2심은 5년 6개월로 늘었고"
  },
  {
   "from_": 631,
   "to": 661,
   "text": "그대로 확정됐습니다."
  },
  {
   "from_": 663,
   "to": 693,
   "text": "다음 사건도\n맞혀 보세요."
  }
 ],
