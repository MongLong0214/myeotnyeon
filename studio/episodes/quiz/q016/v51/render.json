 "subtitles": [
  {
   "from_": 0,
   "to": 37,
   "text": "도심 역주행 사고로"
  },
  {
   "from_": 37,
   "to": 71,
   "text": "9명이 숨졌습니다."
  },
  {
   "from_": 75,
   "to": 102,
   "text": "몇 년 받았을까?"
  },
  {
   "from_": 106,
   "to": 164,
   "text": "운전자는 급발진을\n주장했지만"
  },
  {
   "from_": 164,
   "to": 214,
   "text": "법원은 받아들이지\n않았죠."
  },
  {
   "from_": 219,
   "to": 267,
   "text": "급발진에서 나타날 신호는"
  },
  {
   "from_": 267,
   "to": 298,
   "text": "없다고 봤습니다."
  },
  {
   "from_": 303,
   "to": 333,
   "text": "1심과 2심은"
  },
  {
   "from_": 333,
   "to": 409,
   "text": "여러 피해를 어떻게\n처벌할지 달리 봤습니다."
  },
  {
   "from_": 415,
   "to": 474,
   "text": "1심은 인도와 차량 충돌 사고를"
  },
  {
   "from_": 474,
   "to": 518,
   "text": "각각 별개의 행위로 봤죠."
  },
  {
   "from_": 521,
   "to": 591,
   "text": "벌금, 집행유예, 실형 중\n무엇이었을까요?"
  },
  {
   "from_": 596,
   "to": 661,
   "text": "2심은 하나의 운전행위로\n봤습니다."
  },
  {
   "from_": 667,
   "to": 692,
   "text": "한 번의 운전으로"
  },
  {
   "from_": 692,
   "to": 746,
   "text": "여러 죄가 성립한\n경우였죠."
  },
  {
   "from_": 750,
   "to": 829,
   "text": "가장 무거운 죄에\n정해진 형으로 처벌합니다."
  },
  {
   "from_": 829,
   "to": 845,
   "text": "실형."
  },
  {
   "from_": 848,
   "to": 889,
   "text": "금고 7년 6개월에서"
  },
  {
   "from_": 889,
   "to": 940,
   "text": "5년으로 줄어\n확정됐습니다."
  },
  {
   "from_": 944,
   "to": 982,
   "text": "금고는 징역과 달리"
  },
  {
   "from_": 982,
   "to": 1015,
   "text": "노역 의무가 없습니다."
  },
  {
   "from_": 1024,
   "to": 1064,
   "text": "다음 사건도\n맞혀 보세요."
  }
 ],
 "audio": "q016/v51/mix_master.wav"
