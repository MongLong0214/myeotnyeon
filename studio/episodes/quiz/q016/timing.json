 "items": [
  {
   "id": "C1_1",
   "cue": "C1",
   "act": "incident",
   "start": 4,
   "end": 67,
   "file": "audio/na/C1_1.wav",
   "text": "도심 역주행 사고로 9명이 숨졌습니다."
  },
  {
   "id": "C2_1",
   "cue": "C2",
   "act": "incident",
   "start": 76,
   "end": 167,
   "file": "audio/na/C2_1.wav",
   "text": "운전자는 급발진을 주장했지만 법원은 받아들이지 않았죠."
  },
  {
   "id": "C2_2",
   "cue": "C2",
   "act": "incident",
   "start": 172,
   "end": 235,
   "file": "audio/na/C2_2.wav",
   "text": "급발진에서 나타날 신호는 없다고 봤습니다."
  },
  {
   "id": "C3_1",
   "cue": "C3",
   "act": "incident",
   "start": 244,
   "end": 338,
   "file": "audio/na/C3_1.wav",
   "text": "1심과 2심은 여러 피해를 어떻게 처벌할지 달리 봤습니다."
  },
  {
   "id": "C3_2",
   "cue": "C3",
   "act": "incident",
   "start": 343,
   "end": 443,
   "file": "audio/na/C3_2.wav",
   "text": "1심은 인도와 차량 충돌 사고를 각각 별개의 행위로 봤죠."
  },
  {
   "id": "C4_1",
   "cue": "C4",
   "act": "weigh",
   "start": 461,
   "end": 521,
   "file": "audio/na/C4_1.wav",
   "text": "벌금, 집행유예, 실형 중 무엇이었을까요?"
  },
  {
   "id": "C4_2",
   "cue": "C4",
   "act": "weigh",
   "start": 526,
   "end": 577,
   "file": "audio/na/C4_2.wav",
   "text": "2심은 하나의 운전행위로 봤습니다."
  },
  {
   "id": "C4_3",
   "cue": "C4",
   "act": "weigh",
   "start": 582,
   "end": 650,
   "file": "audio/na/C4_3.wav",
   "text": "한 번의 운전으로 여러 죄가 성립한 경우였죠."
  },
  {
   "id": "C4_4",
   "cue": "C4",
   "act": "weigh",
   "start": 655,
   "end": 720,
   "file": "audio/na/C4_4.wav",
   "text": "가장 무거운 죄에 정해진 형으로 처벌합니다."
  },
  {
   "id": "C5_1",
   "cue": "C5",
   "act": "reveal",
   "start": 741,
   "end": 843,
   "file": "audio/na/C5_1.wav",
   "text": "실형. 금고 7년 6개월에서 5년으로 줄어 확정됐습니다."
  },
  {
   "id": "C5_2",
   "cue": "C5",
   "act": "reveal",
   "start": 848,
   "end": 914,
   "file": "audio/na/C5_2.wav",
   "text": "금고는 징역과 달리 노역 의무가 없습니다."
  },
  {
   "id": "C6_1",
   "cue": "C6",
   "act": "outro",
   "start": 923,
   "end": 961,
   "file": "audio/na/C6_1.wav",
   "text": "다음 사건도 맞혀 보세요."
  }
