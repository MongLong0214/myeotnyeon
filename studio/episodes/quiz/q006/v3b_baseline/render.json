 "subtitles": [
  {
   "from_": 4,
   "to": 78,
   "text": "아파트 동대표 회의에서\n다툰 두 동대표가,"
  },
  {
   "from_": 78,
   "to": 127,
   "text": "싸움에 이의를\n제기하지 않겠다는"
  },
  {
   "from_": 127,
   "to": 171,
   "text": "각서를 썼습니다."
  },
  {
   "from_": 171,
   "to": 223,
   "text": "그리고 밖으로 나가\n몸싸움을 벌였죠."
  },
  {
   "from_": 232,
   "to": 322,
   "text": "40대가 주먹과 발로\n50대의 얼굴 등을 때렸고,"
  },
  {
   "from_": 322,
   "to": 386,
   "text": "50대는 몇 걸음 걷다\n쓰러진 뒤,"
  },
  {
   "from_": 386,
   "to": 461,
   "text": "병원으로 옮겨졌지만\n끝내 숨졌습니다."
  },
  {
   "from_": 476,
   "to": 486,
   "text": "자,"
  },
  {
   "from_": 486,
   "to": 513,
   "text": "몇 년 받았을까요?"
  },
  {
   "from_": 513,
   "to": 534,
   "text": "벌금일까요,"
  },
  {
   "from_": 534,
   "to": 559,
   "text": "집행유예일까요,"
  },
  {
   "from_": 559,
   "to": 587,
   "text": "아니면 실형일까요?"
  },
  {
   "from_": 686,
   "to": 720,
   "text": "폭행치사는 무죄."
  },
  {
   "from_": 720,
   "to": 754,
   "text": "폭행죄만 인정돼,"
  },
  {
   "from_": 754,
   "to": 816,
   "text": "징역 10개월에\n집행유예 2년입니다."
  },
  {
   "from_": 831,
   "to": 889,
   "text": "숨질 걸 예견하긴\n어려웠다고 봤고,"
  },
  {
   "from_": 889,
   "to": 931,
   "text": "피해자가 먼저\n때린 점,"
  },
  {
   "from_": 931,
   "to": 986,
   "text": "우발적이었던 점도\n고려했대요."
  },
  {
   "from_": 998,
   "to": 1069,
   "text": "유족은 합의를 거부하고\n엄벌을 탄원했지만,"
  },
  {
   "from_": 1069,
   "to": 1114,
   "text": "2심 판단도\n같았습니다."
  },
  {
   "from_": 1126,
   "to": 1159,
   "text": "다음 사건도\n맞혀 보세요."
  }
 ],
 "audio": "q006/mix_master.wav"
