 "items": [
  {
   "id": "C1_1",
   "cue": "C1",
   "act": "incident",
   "start": 4,
   "end": 112,
   "file": "audio/na/C1_1.wav",
   "text": "27명이 숨진 지난해 경북 산불은 두 곳에서 시작됐습니다."
  },
  {
   "id": "C1_2",
   "cue": "C1",
   "act": "incident",
   "start": 117,
   "end": 179,
   "file": "audio/na/C1_2.wav",
   "text": "그중 한 곳이 의성군에 있는 과수원이었죠."
  },
  {
   "id": "C2_1",
   "cue": "C2",
   "act": "incident",
   "start": 188,
   "end": 373,
   "file": "audio/na/C2_1.wav",
   "text": "60대 과수원 임차인이 농사 부산물을 태운 뒤 불씨가 꺼졌는지 확인하지 않고 자리를 떠난 혐의였습니다."
  },
  {
   "id": "C3_1",
   "cue": "C3",
   "act": "incident",
   "start": 382,
   "end": 453,
   "file": "audio/na/C3_1.wav",
   "text": "불은 강풍을 타고 5개 시·군까지 번졌죠."
  },
  {
   "id": "C4_1",
   "cue": "C4",
   "act": "incident",
   "start": 462,
   "end": 565,
   "file": "audio/na/C4_1.wav",
   "text": "149시간 동안 27명이 숨지고 40명이 다쳤습니다."
  },
  {
   "id": "C5_1",
   "cue": "C5",
   "act": "weigh",
   "start": 577,
   "end": 645,
   "file": "audio/na/C5_1.wav",
   "text": "벌금, 집행유예, 실형 중 무엇이었을까요?"
  },
  {
   "id": "C5_2",
   "cue": "C5",
   "act": "weigh",
   "start": 650,
   "end": 727,
   "file": "audio/na/C5_2.wav",
   "text": "2심 재판부는 결과가 상당히 무겁다고 봤습니다."
  },
  {
   "id": "C5_3",
   "cue": "C5",
   "act": "weigh",
   "start": 732,
   "end": 784,
   "file": "audio/na/C5_3.wav",
   "text": "죄명은 실수로 불을 낸 실화였고요."
  },
  {
   "id": "C5_4",
   "cue": "C5",
   "act": "weigh",
   "start": 789,
   "end": 862,
   "file": "audio/na/C5_4.wav",
   "text": "2심에서 검찰 구형은 징역 3년이었습니다."
  },
  {
   "id": "C6_1",
   "cue": "C6",
   "act": "reveal",
   "start": 871,
   "end": 937,
   "file": "audio/na/C6_1.wav",
   "text": "1심은 징역 2년 6개월에 집행유예 3년."
  },
  {
   "id": "C6_2",
   "cue": "C6",
   "act": "reveal",
   "start": 942,
   "end": 982,
   "file": "audio/na/C6_2.wav",
   "text": "2심 판결도 그대로였습니다."
  },
  {
   "id": "C7_1",
   "cue": "C7",
   "act": "outro",
   "start": 997,
   "end": 1033,
   "file": "audio/na/C7_1.wav",
   "text": "다음 사건도 맞혀 보세요."
  }
